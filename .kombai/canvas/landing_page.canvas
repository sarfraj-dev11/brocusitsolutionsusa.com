      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Manrope:wght@200..800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #0a0916;\n    --purple: #8B5CF6;\n    --orange: #FB923C;\n    --glass: rgba(255, 255, 255, 0.03);\n    --glass-border: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--bg-base);\n    color: #ffffff;\n    font-family: 'Manrope', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n  \n  .glass-card {\n    background: var(--glass);\n    backdrop-filter: blur(20px);\n    border: 1px solid var(--glass-border);\n    border-radius: 24px;\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, #fff 30%, var(--purple) 70%, var(--orange) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .blurred-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(100px);\n    z-index: -1;\n    opacity: 0.4;\n  }\n\n  /* Animations */\n  @keyframes slowFloat {\n    0%, 100% { transform: translate(0, 0); }\n    50% { transform: translate(-20px, 30px); }\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div class=\"blurred-orb w-[600px] h-[600px] bg-[#8B5CF6] top-[-200px] left-[-100px] animate-[slowFloat_15s_infinite]\" data-kid=\"2\"></div>\n  <div class=\"blurred-orb w-[500px] h-[500px] bg-[#FB923C] bottom-[-100px] right-[-100px] animate-[slowFloat_20s_infinite_reverse]\" data-kid=\"3\"></div>\n\n  \n  <nav class=\"fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-12 py-6 backdrop-blur-md bg-black/10 border-b border-white/5\" data-kid=\"4\">\n    <div class=\"flex items-center gap-3\" data-kid=\"5\">\n      <img src=\"/api/local/images/assets/images/logo.png\" alt=\"Brocus Logo\" class=\"h-10 w-auto\" data-kid=\"6\">\n      <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"7\">BROCUS</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-10 text-sm font-medium text-white/70\" data-kid=\"8\">\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"9\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Services</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Impact</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"12\">About</a>\n    </div>\n    <button class=\"px-6 py-2.5 bg-white text-black font-semibold rounded-full hover:bg-white/90 transition-all active:scale-95\" data-kid=\"13\">\n      Start Project\n    </button>\n  </nav>\n\n  \n  <section class=\"relative h-screen flex flex-col items-center justify-center text-center px-6 overflow-hidden\" data-kid=\"14\">\n    \n    <video src=\"https://videos.pexels.com/video-files/6866291/6866291-hd_1980_1080_25fps.mp4\" poster=\"https://images.pexels.com/videos/6866291/blurred-blurred-light-bright-light-christmas-lights-6866291.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-screen pointer-events-none\" data-kid=\"15\"></video>\n\n    <div class=\"relative z-10 max-w-5xl\" data-kid=\"16\">\n      <div class=\"inline-flex items-center px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-widest text-white/50 mb-8 uppercase\" data-kid=\"17\">\n        Supercharging Enterprise IT\n      </div>\n      <h1 class=\"font-heading text-7xl md:text-9xl font-bold leading-[0.9] tracking-tighter gradient-text mb-8\" data-kid=\"18\">\n        The Future <br data-kid=\"19\"> of Tech is Ethereal\n      </h1>\n      <p class=\"text-xl md:text-2xl text-white/60 max-w-2xl mx-auto leading-relaxed mb-12\" data-kid=\"20\">\n        We craft high-performance software, secure cloud architectures, and digital experiences that feel like magic.\n      </p>\n      \n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\" data-kid=\"21\">\n        <div class=\"relative w-full max-w-md\" data-kid=\"22\">\n          <input type=\"email\" placeholder=\"Enter your business email\" class=\"w-full px-8 py-4 bg-white/5 border border-white/10 rounded-full focus:outline-hidden focus:ring-2 focus:ring-[#8B5CF6]/50 transition-all backdrop-blur-xl\" data-kid=\"23\">\n          <button class=\"absolute right-2 top-2 bottom-2 px-6 bg-[#8B5CF6] text-white font-bold rounded-full hover:bg-[#7C3AED] transition-colors\" data-kid=\"24\">\n            Connect\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 max-w-7xl mx-auto\" data-kid=\"25\">\n    <div class=\"mb-16 text-center\" data-kid=\"26\">\n      <h2 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"27\">Precision Engineered Solutions</h2>\n      <p class=\"text-white/40\" data-kid=\"28\">From discovery to deployment, we build what matters.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[300px]\" data-kid=\"29\">\n      \n      <div class=\"md:col-span-2 md:row-span-2 glass-card p-10 flex flex-col justify-between group relative overflow-hidden\" data-kid=\"30\">\n        <div class=\"relative z-10\" data-kid=\"31\">\n          <div class=\"w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center mb-6\" data-kid=\"32\">\n            <i class=\"ti ti-cloud-bolt text-2xl text-blue-400\" data-kid=\"33\"></i>\n          </div>\n          <h3 class=\"font-heading text-3xl font-bold mb-4\" data-kid=\"34\">Cloud Migration & Scaling</h3>\n          <p class=\"text-white/50 text-lg max-w-md\" data-kid=\"35\">\n            Zero-downtime infrastructure shifts that grow with your user base. Automated scaling for global resilience.\n          </p>\n        </div>\n        \n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/waves.svg\" class=\"absolute bottom-[-50px] right-[-50px] w-96 h-96 opacity-5 pointer-events-none group-hover:scale-110 transition-transform duration-1000\" style=\"color: #8B5CF6;\" data-kid=\"36\">\n             \n        <div class=\"relative z-10 flex items-center gap-4 text-sm font-bold text-blue-400 mt-8 cursor-pointer\" data-kid=\"37\">\n          EXPLORE ARCHITECTURE <i class=\"ti ti-arrow-right\" data-kid=\"38\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"glass-card p-8 flex flex-col justify-between group\" data-kid=\"39\">\n        <div data-kid=\"40\">\n          <div class=\"w-10 h-10 rounded-lg bg-orange-500/20 flex items-center justify-center mb-6\" data-kid=\"41\">\n            <i class=\"ti ti-shield-check text-xl text-orange-400\" data-kid=\"42\"></i>\n          </div>\n          <h3 class=\"font-heading text-xl font-bold mb-2\" data-kid=\"43\">Zero-Trust Security</h3>\n          <p class=\"text-white/40 text-sm\" data-kid=\"44\">Enterprise-grade protection for every endpoint and connection.</p>\n        </div>\n        <div class=\"text-xs font-bold text-white/20 tracking-widest mt-4\" data-kid=\"45\">ACTIVE PROTECTION</div>\n      </div>\n\n      \n      <div class=\"glass-card p-8 flex flex-col justify-between group\" data-kid=\"46\">\n        <div data-kid=\"47\">\n          <div class=\"w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center mb-6\" data-kid=\"48\">\n            <i class=\"ti ti-code text-xl text-purple-400\" data-kid=\"49\"></i>\n          </div>\n          <h3 class=\"font-heading text-xl font-bold mb-2\" data-kid=\"50\">Custom Software</h3>\n          <p class=\"text-white/40 text-sm\" data-kid=\"51\">Bespoke digital tools tailored specifically for your workflow.</p>\n        </div>\n        <div class=\"text-xs font-bold text-white/20 tracking-widest mt-4\" data-kid=\"52\">INITIALIZE REPO</div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-40 overflow-hidden\" data-kid=\"53\">\n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"54\">\n      <span class=\"font-heading text-[30vw] font-black text-white/[0.02] leading-none select-none\" data-kid=\"55\">99.9%</span>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto px-12 relative z-10\" data-kid=\"56\">\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 text-center\" data-kid=\"57\">\n        <div data-kid=\"58\">\n          <div class=\"font-heading text-5xl font-bold mb-2\" data-kid=\"59\">99.9%</div>\n          <div class=\"text-sm text-white/40 uppercase tracking-widest\" data-kid=\"60\">Platform Uptime</div>\n        </div>\n        <div data-kid=\"61\">\n          <div class=\"font-heading text-5xl font-bold mb-2\" data-kid=\"62\">2.4PB</div>\n          <div class=\"text-sm text-white/40 uppercase tracking-widest\" data-kid=\"63\">Data Managed</div>\n        </div>\n        <div data-kid=\"64\">\n          <div class=\"font-heading text-5xl font-bold mb-2\" data-kid=\"65\">0</div>\n          <div class=\"text-sm text-white/40 uppercase tracking-widest\" data-kid=\"66\">Security Breaches</div>\n        </div>\n        <div data-kid=\"67\">\n          <div class=\"font-heading text-5xl font-bold mb-2\" data-kid=\"68\">500+</div>\n          <div class=\"text-sm text-white/40 uppercase tracking-widest\" data-kid=\"69\">Happy Partners</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 overflow-hidden\" data-kid=\"70\">\n    <div class=\"max-w-7xl mx-auto mb-16 flex items-end justify-between\" data-kid=\"71\">\n      <div data-kid=\"72\">\n        <h2 class=\"font-heading text-4xl font-bold mb-2\" data-kid=\"73\">Trusted by Giants</h2>\n        <p class=\"text-white/40\" data-kid=\"74\">Don't just take our word for it.</p>\n      </div>\n    </div>\n\n    <div class=\"flex gap-8 overflow-x-auto pb-12 scrollbar-none\" data-kid=\"75\">\n      \n      <div class=\"glass-card p-10 min-w-[450px] relative group\" data-kid=\"76\">\n        <i class=\"ti ti-quote text-6xl text-white/5 absolute top-4 right-4 group-hover:text-purple-500/10 transition-colors\" data-kid=\"77\"></i>\n        <p class=\"text-lg text-white/80 leading-relaxed mb-10 italic\" data-kid=\"78\">\n          \"Brocus transformed our legacy infrastructure into a cloud-native powerhouse in under 3 months. Their attention to security is unmatched.\"\n        </p>\n        <div class=\"flex items-center gap-4\" data-kid=\"79\">\n          <img src=\"https://i.pravatar.cc/100?u=sarah\" class=\"w-12 h-12 rounded-full grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all\" data-kid=\"80\">\n          <div data-kid=\"81\">\n            <div class=\"font-bold\" data-kid=\"82\">Sarah Chen</div>\n            <div class=\"text-xs text-white/40\" data-kid=\"83\">CTO, Vertex Scale</div>\n          </div>\n        </div>\n      </div>\n      \n      \n      <div class=\"glass-card p-10 min-w-[450px] relative group\" data-kid=\"84\">\n        <i class=\"ti ti-quote text-6xl text-white/5 absolute top-4 right-4 group-hover:text-orange-500/10 transition-colors\" data-kid=\"85\"></i>\n        <p class=\"text-lg text-white/80 leading-relaxed mb-10 italic\" data-kid=\"86\">\n          \"The most professional development partner we've worked with. The ethereal design isn't just for show—the UX is flawless.\"\n        </p>\n        <div class=\"flex items-center gap-4\" data-kid=\"87\">\n          <img src=\"https://i.pravatar.cc/100?u=james\" class=\"w-12 h-12 rounded-full grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all\" data-kid=\"88\">\n          <div data-kid=\"89\">\n            <div class=\"font-bold\" data-kid=\"90\">James Wilson</div>\n            <div class=\"text-xs text-white/40\" data-kid=\"91\">Product Lead, NexaCorp</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"glass-card p-10 min-w-[450px] relative group\" data-kid=\"92\">\n        <i class=\"ti ti-quote text-6xl text-white/5 absolute top-4 right-4 group-hover:text-blue-500/10 transition-colors\" data-kid=\"93\"></i>\n        <p class=\"text-lg text-white/80 leading-relaxed mb-10 italic\" data-kid=\"94\">\n          \"Zero breaches in 2 years of operation. Brocus isn't just an IT vendor; they are our primary security buffer.\"\n        </p>\n        <div class=\"flex items-center gap-4\" data-kid=\"95\">\n          <img src=\"https://i.pravatar.cc/100?u=nina\" class=\"w-12 h-12 rounded-full grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all\" data-kid=\"96\">\n          <div data-kid=\"97\">\n            <div class=\"font-bold\" data-kid=\"98\">Nina Rodriguez</div>\n            <div class=\"text-xs text-white/40\" data-kid=\"99\">Founder, SecureNode</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"pt-32 pb-16 px-12 border-t border-white/5 bg-gradient-to-b from-transparent to-black\" data-kid=\"100\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"101\">\n      <div class=\"md:col-span-2\" data-kid=\"102\">\n        <div class=\"flex items-center gap-3 mb-6\" data-kid=\"103\">\n          <img src=\"/api/local/images/assets/images/logo.png\" alt=\"Brocus Logo\" class=\"h-8 w-auto\" data-kid=\"104\">\n          <span class=\"font-heading text-lg font-bold tracking-tight\" data-kid=\"105\">BROCUS</span>\n        </div>\n        <p class=\"text-white/40 max-w-sm mb-8\" data-kid=\"106\">\n          Enterprise IT solutions for a digital-first world. Building the infrastructure of tomorrow, today.\n        </p>\n        <div class=\"flex gap-6 text-xl text-white/20\" data-kid=\"107\">\n          <i class=\"ti ti-brand-x hover:text-white transition-colors cursor-pointer\" data-kid=\"108\"></i>\n          <i class=\"ti ti-brand-linkedin hover:text-white transition-colors cursor-pointer\" data-kid=\"109\"></i>\n          <i class=\"ti ti-brand-github hover:text-white transition-colors cursor-pointer\" data-kid=\"110\"></i>\n        </div>\n      </div>\n      \n      <div data-kid=\"111\">\n        <h4 class=\"font-heading font-bold mb-6\" data-kid=\"112\">Solutions</h4>\n        <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"113\">\n          <li data-kid=\"114\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"115\">Cloud Architecture</a></li>\n          <li data-kid=\"116\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"117\">Cybersecurity</a></li>\n          <li data-kid=\"118\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"119\">Product Dev</a></li>\n          <li data-kid=\"120\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"121\">Consultancy</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"122\">\n        <h4 class=\"font-heading font-bold mb-6\" data-kid=\"123\">Company</h4>\n        <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"124\">\n          <li data-kid=\"125\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"126\">Our Story</a></li>\n          <li data-kid=\"127\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"128\">Contact</a></li>\n          <li data-kid=\"129\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"130\">Privacy Policy</a></li>\n          <li data-kid=\"131\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"132\">Terms</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-24 pt-8 border-t border-white/5 text-center text-xs text-white/20\" data-kid=\"133\">\n      &copy; 2024 Brocus IT Solutions. All rights reserved.\n    </div>\n  </footer>\n</div>",
