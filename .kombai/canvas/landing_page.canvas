      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@200;300;400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg: #050508;\n    --purple: #8B5CF6;\n    --orange: #FB923C;\n    --white: #ffffff;\n  }\n\n  body {\n    background-color: var(--bg);\n    color: var(--white);\n    font-family: 'Manrope', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-heading {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .text-gradient-purple {\n    background: linear-gradient(135deg, #A78BFA, #8B5CF6);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .text-gradient-orange {\n    background: linear-gradient(135deg, #FB923C, #F97316);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .marquee-content {\n    animation: marquee 30s linear infinite;\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .glow-on-hover:hover {\n    box-shadow: 0 0 40px rgba(139, 92, 246, 0.2);\n    border-color: rgba(139, 92, 246, 0.4);\n  }\n\n  .floating {\n    animation: float 6s ease-in-out infinite;\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-20px); }\n  }\n\n  .hero-blob {\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, rgba(5, 5, 8, 0) 70%);\n    filter: blur(60px);\n    z-index: -1;\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"flex items-center justify-between px-10 py-8 relative z-50\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[var(--purple)] rounded-lg flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-binary text-white text-2xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-heading font-bold text-2xl tracking-tight\" data-kid=\"6\">BROCUS</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-white/70\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"8\">Services</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"9\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Case Studies</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Company</a>\n    </div>\n    <button class=\"px-6 py-2.5 bg-[var(--purple)] hover:bg-[var(--purple)]/90 text-white rounded-full text-sm font-semibold transition-all\" data-kid=\"12\">\n      Start a Project\n    </button>\n  </nav>\n\n  \n  <section class=\"relative px-10 pt-20 pb-32 overflow-hidden\" data-kid=\"13\">\n    <div class=\"hero-blob -top-40 -left-20\" data-kid=\"14\"></div>\n    <div class=\"hero-blob top-1/2 -right-40 opacity-50\" data-kid=\"15\"></div>\n    \n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"16\">\n      <div class=\"relative z-10\" data-kid=\"17\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--purple)]/30 bg-[var(--purple)]/10 mb-6\" data-kid=\"18\">\n          <span class=\"w-2 h-2 rounded-full bg-[var(--purple)] animate-pulse\" data-kid=\"19\"></span>\n          <span class=\"text-[var(--purple)] text-xs font-bold uppercase tracking-widest\" data-kid=\"20\">Supercharge Your IT</span>\n        </div>\n        <h1 class=\"font-heading text-7xl md:text-8xl font-bold leading-[0.9] mb-8 tracking-tighter\" data-kid=\"21\">\n          Engineering the <span class=\"text-gradient-purple\" data-kid=\"22\">Future</span> of Enterprise.\n        </h1>\n        <p class=\"text-xl text-white/60 mb-10 max-w-lg leading-relaxed\" data-kid=\"23\">\n          We deliver mission-critical software development, secure cloud architecture, and proactive cybersecurity solutions tailored for global scale.\n        </p>\n        <div class=\"flex flex-wrap gap-4\" data-kid=\"24\">\n          <button class=\"px-8 py-4 bg-white text-black font-bold rounded-xl hover:scale-105 transition-transform flex items-center gap-2\" data-kid=\"25\">\n            View Solutions <i class=\"ti ti-arrow-right\" data-kid=\"26\"></i>\n          </button>\n          <button class=\"px-8 py-4 glass text-white font-bold rounded-xl hover:bg-white/10 transition-colors\" data-kid=\"27\">\n            Our Portfolio\n          </button>\n        </div>\n      </div>\n\n      <div class=\"relative h-[600px] hidden lg:block\" data-kid=\"28\">\n        \n        <div class=\"absolute top-10 right-0 w-80 glass p-6 rounded-2xl floating z-20\" data-kid=\"29\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"30\">\n            <div class=\"w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center\" data-kid=\"31\">\n              <i class=\"ti ti-shield-check text-green-500 text-lg\" data-kid=\"32\"></i>\n            </div>\n            <span class=\"font-heading font-semibold text-sm\" data-kid=\"33\">Security Matrix Active</span>\n          </div>\n          <div class=\"space-y-2\" data-kid=\"34\">\n            <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"35\">\n              <div class=\"h-full bg-green-500 w-3/4\" data-kid=\"36\"></div>\n            </div>\n            <div class=\"flex justify-between text-[10px] text-white/40 uppercase font-bold tracking-widest\" data-kid=\"37\">\n              <span data-kid=\"38\">Threat Scanning</span>\n              <span data-kid=\"39\">75% Complete</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"absolute bottom-20 left-10 w-72 glass p-6 rounded-2xl floating z-30\" style=\"animation-delay: -2s;\" data-kid=\"40\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"41\">\n            <div class=\"w-8 h-8 rounded-full bg-[var(--purple)]/20 flex items-center justify-center\" data-kid=\"42\">\n              <i class=\"ti ti-cloud-storm text-[var(--purple)] text-lg\" data-kid=\"43\"></i>\n            </div>\n            <span class=\"font-heading font-semibold text-sm\" data-kid=\"44\">Cloud Infrastructure</span>\n          </div>\n          <div class=\"flex items-end gap-1 mb-2\" data-kid=\"45\">\n            <div class=\"w-full h-12 bg-[var(--purple)]/20 rounded-t-sm\" data-kid=\"46\"></div>\n            <div class=\"w-full h-16 bg-[var(--purple)]/40 rounded-t-sm\" data-kid=\"47\"></div>\n            <div class=\"w-full h-10 bg-[var(--purple)]/20 rounded-t-sm\" data-kid=\"48\"></div>\n            <div class=\"w-full h-20 bg-[var(--purple)] rounded-t-sm\" data-kid=\"49\"></div>\n          </div>\n          <p class=\"text-[10px] text-white/40 font-bold uppercase tracking-widest\" data-kid=\"50\">Global Traffic Distribution</p>\n        </div>\n\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] glass rounded-3xl overflow-hidden shadow-2xl z-10\" data-kid=\"51\">\n          <img src=\"https://images.unsplash.com/photo-1680992044138-ce4864c2b962?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-50 scale-110\" alt=\"Server Rack\" decoding=\"async\" loading=\"lazy\" data-kid=\"52\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--bg)] to-transparent\" data-kid=\"53\"></div>\n          <div class=\"absolute bottom-8 left-8 right-8\" data-kid=\"54\">\n            <p class=\"font-heading text-2xl font-bold mb-2\" data-kid=\"55\">Brocus Core</p>\n            <p class=\"text-xs text-white/60 leading-relaxed uppercase tracking-widest font-bold\" data-kid=\"56\">Initializing System_Protocol_01...</p>\n          </div>\n        </div>\n        \n        \n        <div class=\"absolute -top-10 left-10 opacity-20 rotate-12\" data-kid=\"57\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/nested-hexagons.svg\" class=\"w-40 h-40 filter-white\" style=\"filter: invert(1);\" alt=\"Shape\" decoding=\"async\" loading=\"lazy\" data-kid=\"58\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-12 border-y border-white/5 bg-white/[0.02] overflow-hidden\" data-kid=\"59\">\n    <div class=\"marquee-content flex gap-16 items-center\" data-kid=\"60\">\n      <div class=\"flex gap-16 items-center shrink-0\" data-kid=\"61\">\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"62\">AWS Infrastructure</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--purple)]\" data-kid=\"63\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"64\">Azure Solutions</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--orange)]\" data-kid=\"65\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"66\">React Development</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--purple)]\" data-kid=\"67\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"68\">Node.js Scalability</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--orange)]\" data-kid=\"69\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"70\">Kubernetes Orchestration</span>\n      </div>\n      \n      <div class=\"flex gap-16 items-center shrink-0\" data-kid=\"71\">\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"72\">AWS Infrastructure</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--purple)]\" data-kid=\"73\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"74\">Azure Solutions</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--orange)]\" data-kid=\"75\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"76\">React Development</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--purple)]\" data-kid=\"77\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"78\">Node.js Scalability</span>\n        <span class=\"w-2 h-2 rounded-full bg-[var(--orange)]\" data-kid=\"79\"></span>\n        <span class=\"font-heading text-4xl font-bold text-white/10 uppercase tracking-tighter\" data-kid=\"80\">Kubernetes Orchestration</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-10 py-32 max-w-7xl mx-auto\" data-kid=\"81\">\n    <div class=\"flex flex-col md:flex-row justify-between items-end mb-20 gap-8\" data-kid=\"82\">\n      <div class=\"max-w-xl\" data-kid=\"83\">\n        <h2 class=\"font-heading text-5xl font-bold mb-6 tracking-tight\" data-kid=\"84\">Core Expertise</h2>\n        <p class=\"text-white/50 text-lg\" data-kid=\"85\">We don't just build software. We engineer resilient digital ecosystems that empower your business to dominate the competition.</p>\n      </div>\n      <a href=\"#\" class=\"text-[var(--purple)] font-bold flex items-center gap-2 group\" data-kid=\"86\">\n        Explore All Services <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"87\"></i>\n      </a>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"88\">\n      \n      <div class=\"glass p-10 rounded-3xl glow-on-hover transition-all duration-500 relative group\" data-kid=\"89\">\n        <div class=\"w-14 h-14 rounded-2xl bg-[var(--purple)]/20 flex items-center justify-center mb-8 group-hover:bg-[var(--purple)] transition-colors\" data-kid=\"90\">\n          <i class=\"ti ti-code text-[var(--purple)] text-3xl group-hover:text-white transition-colors\" data-kid=\"91\"></i>\n        </div>\n        <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"92\">Software Development</h3>\n        <p class=\"text-white/50 mb-8\" data-kid=\"93\">Bespoke web and mobile applications engineered for performance, scalability, and seamless user experiences.</p>\n        <ul class=\"space-y-3 text-sm text-white/70\" data-kid=\"94\">\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"95\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"96\"></i> Custom CRM Systems</li>\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"97\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"98\"></i> High-Traffic Web Apps</li>\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"99\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"100\"></i> Legacy Modernization</li>\n        </ul>\n      </div>\n\n      \n      <div class=\"glass p-10 rounded-3xl glow-on-hover transition-all duration-500 relative group\" data-kid=\"101\">\n        <div class=\"w-14 h-14 rounded-2xl bg-[var(--purple)]/20 flex items-center justify-center mb-8 group-hover:bg-[var(--purple)] transition-colors\" data-kid=\"102\">\n          <i class=\"ti ti-cloud-storm text-[var(--purple)] text-3xl group-hover:text-white transition-colors\" data-kid=\"103\"></i>\n        </div>\n        <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"104\">Cloud Architecture</h3>\n        <p class=\"text-white/50 mb-8\" data-kid=\"105\">Modernize your infrastructure with cloud-native strategies that reduce costs and increase availability.</p>\n        <ul class=\"space-y-3 text-sm text-white/70\" data-kid=\"106\">\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"107\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"108\"></i> Multi-Cloud Strategy</li>\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"109\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"110\"></i> Serverless Deployment</li>\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"111\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"112\"></i> DevOps Automation</li>\n        </ul>\n      </div>\n\n      \n      <div class=\"glass p-10 rounded-3xl glow-on-hover transition-all duration-500 relative group\" data-kid=\"113\">\n        <div class=\"w-14 h-14 rounded-2xl bg-[var(--purple)]/20 flex items-center justify-center mb-8 group-hover:bg-[var(--purple)] transition-colors\" data-kid=\"114\">\n          <i class=\"ti ti-shield-check text-[var(--purple)] text-3xl group-hover:text-white transition-colors\" data-kid=\"115\"></i>\n        </div>\n        <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"116\">Enterprise Security</h3>\n        <p class=\"text-white/50 mb-8\" data-kid=\"117\">Protect your digital assets with advanced threat detection, encryption, and rigorous security audits.</p>\n        <ul class=\"space-y-3 text-sm text-white/70\" data-kid=\"118\">\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"119\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"120\"></i> Zero-Trust Architecture</li>\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"121\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"122\"></i> Penetration Testing</li>\n          <li class=\"flex items-center gap-2 italic\" data-kid=\"123\"><i class=\"ti ti-circle-check text-[var(--purple)]\" data-kid=\"124\"></i> Data Privacy Compliance</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-10 py-32 bg-white/[0.01]\" data-kid=\"125\">\n    <div class=\"max-w-4xl mx-auto\" data-kid=\"126\">\n      <div class=\"text-center mb-24\" data-kid=\"127\">\n        <h2 class=\"font-heading text-5xl font-bold mb-6 tracking-tight\" data-kid=\"128\">The Brocus Blueprint</h2>\n        <p class=\"text-white/50 text-lg\" data-kid=\"129\">Our proven methodology ensures your project moves from vision to production with surgical precision.</p>\n      </div>\n\n      <div class=\"relative\" data-kid=\"130\">\n        \n        <div class=\"absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-[var(--purple)] via-white/10 to-transparent hidden md:block\" data-kid=\"131\"></div>\n\n        <div class=\"space-y-24\" data-kid=\"132\">\n          \n          <div class=\"flex flex-col md:flex-row items-center gap-12 group\" data-kid=\"133\">\n            <div class=\"md:w-1/2 md:text-right\" data-kid=\"134\">\n              <span class=\"text-xs font-bold uppercase tracking-[0.3em] text-[var(--orange)] mb-2 block\" data-kid=\"135\">01 / DISCOVERY</span>\n              <h4 class=\"font-heading text-3xl font-bold mb-4 group-hover:text-gradient-orange transition-all\" data-kid=\"136\">Strategic Analysis</h4>\n              <p class=\"text-white/50\" data-kid=\"137\">We dive deep into your business goals, technical constraints, and user needs to build a roadmap for success.</p>\n            </div>\n            <div class=\"relative z-10 w-12 h-12 rounded-full bg-[var(--bg)] border-2 border-[var(--orange)] flex items-center justify-center shrink-0 shadow-[0_0_20px_rgba(251,146,60,0.4)]\" data-kid=\"138\">\n              <span class=\"font-heading font-bold text-lg text-[var(--orange)]\" data-kid=\"139\">1</span>\n            </div>\n            <div class=\"md:w-1/2\" data-kid=\"140\"></div>\n          </div>\n\n          \n          <div class=\"flex flex-col md:flex-row-reverse items-center gap-12 group\" data-kid=\"141\">\n            <div class=\"md:w-1/2\" data-kid=\"142\">\n              <span class=\"text-xs font-bold uppercase tracking-[0.3em] text-[var(--orange)] mb-2 block\" data-kid=\"143\">02 / ARCHITECTURE</span>\n              <h4 class=\"font-heading text-3xl font-bold mb-4 group-hover:text-gradient-orange transition-all\" data-kid=\"144\">System Design</h4>\n              <p class=\"text-white/50\" data-kid=\"145\">Our architects create robust blueprints for scalability, security, and integration with your existing stack.</p>\n            </div>\n            <div class=\"relative z-10 w-12 h-12 rounded-full bg-[var(--bg)] border-2 border-[var(--orange)] flex items-center justify-center shrink-0 shadow-[0_0_20px_rgba(251,146,60,0.4)]\" data-kid=\"146\">\n              <span class=\"font-heading font-bold text-lg text-[var(--orange)]\" data-kid=\"147\">2</span>\n            </div>\n            <div class=\"md:w-1/2\" data-kid=\"148\"></div>\n          </div>\n\n          \n          <div class=\"flex flex-col md:flex-row items-center gap-12 group\" data-kid=\"149\">\n            <div class=\"md:w-1/2 md:text-right\" data-kid=\"150\">\n              <span class=\"text-xs font-bold uppercase tracking-[0.3em] text-[var(--orange)] mb-2 block\" data-kid=\"151\">03 / DEVELOPMENT</span>\n              <h4 class=\"font-heading text-3xl font-bold mb-4 group-hover:text-gradient-orange transition-all\" data-kid=\"152\">Agile Sprints</h4>\n              <p class=\"text-white/50\" data-kid=\"153\">Rapid iteration and high-quality coding standards ensure we deliver value early and often.</p>\n            </div>\n            <div class=\"relative z-10 w-12 h-12 rounded-full bg-[var(--bg)] border-2 border-[var(--orange)] flex items-center justify-center shrink-0 shadow-[0_0_20px_rgba(251,146,60,0.4)]\" data-kid=\"154\">\n              <span class=\"font-heading font-bold text-lg text-[var(--orange)]\" data-kid=\"155\">3</span>\n            </div>\n            <div class=\"md:w-1/2\" data-kid=\"156\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-10 py-32\" data-kid=\"157\">\n    <div class=\"max-w-5xl mx-auto relative rounded-[40px] overflow-hidden\" data-kid=\"158\">\n      <div class=\"absolute inset-0 z-0 opacity-20\" data-kid=\"159\">\n        <img src=\"https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover\" alt=\"Server Background\" decoding=\"async\" loading=\"lazy\" data-kid=\"160\">\n      </div>\n      <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--bg)] via-[var(--bg)]/90 to-transparent z-10\" data-kid=\"161\"></div>\n      \n      <div class=\"relative z-20 px-12 md:px-20 py-24 flex flex-col items-center text-center\" data-kid=\"162\">\n        <h2 class=\"font-heading text-6xl md:text-7xl font-bold mb-8 leading-tight tracking-tighter max-w-3xl\" data-kid=\"163\">\n          Ready to <span class=\"text-gradient-orange italic\" data-kid=\"164\">Supercharge</span> your infrastructure?\n        </h2>\n        <p class=\"text-white/60 text-lg mb-12 max-w-xl\" data-kid=\"165\">\n          Join leading enterprises that trust Brocus IT Solutions for mission-critical engineering.\n        </p>\n        <div class=\"flex flex-wrap justify-center gap-6\" data-kid=\"166\">\n          <button class=\"px-10 py-5 bg-[var(--orange)] hover:bg-[var(--orange)]/90 text-white font-black rounded-2xl shadow-xl shadow-[var(--orange)]/20 transition-all flex items-center gap-3\" data-kid=\"167\">\n            Schedule a Consultation <i class=\"ti ti-rocket text-xl\" data-kid=\"168\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"px-10 py-20 border-t border-white/5\" data-kid=\"169\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-16\" data-kid=\"170\">\n      <div class=\"max-w-sm\" data-kid=\"171\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"172\">\n          <div class=\"w-8 h-8 bg-[var(--purple)] rounded-md flex items-center justify-center\" data-kid=\"173\">\n            <i class=\"ti ti-binary text-white\" data-kid=\"174\"></i>\n          </div>\n          <span class=\"font-heading font-bold text-xl tracking-tight\" data-kid=\"175\">BROCUS</span>\n        </div>\n        <p class=\"text-white/40 text-sm leading-relaxed mb-8\" data-kid=\"176\">\n          Next-generation IT solutions for forward-thinking enterprises. Engineering excellence at the speed of business.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"177\">\n          <a href=\"#\" class=\"w-10 h-10 glass rounded-full flex items-center justify-center hover:bg-white/10 transition-colors\" data-kid=\"178\">\n            <i class=\"ti ti-brand-linkedin\" data-kid=\"179\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 glass rounded-full flex items-center justify-center hover:bg-white/10 transition-colors\" data-kid=\"180\">\n            <i class=\"ti ti-brand-twitter\" data-kid=\"181\"></i>\n          </a>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-2 md:grid-cols-3 gap-16\" data-kid=\"182\">\n        <div data-kid=\"183\">\n          <h5 class=\"font-heading font-bold text-sm uppercase tracking-widest mb-6\" data-kid=\"184\">Company</h5>\n          <ul class=\"space-y-4 text-sm text-white/50\" data-kid=\"185\">\n            <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"187\">About Us</a></li>\n            <li data-kid=\"188\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"189\">Our Team</a></li>\n            <li data-kid=\"190\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"191\">Careers</a></li>\n            <li data-kid=\"192\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"193\">Contact</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"194\">\n          <h5 class=\"font-heading font-bold text-sm uppercase tracking-widest mb-6\" data-kid=\"195\">Services</h5>\n          <ul class=\"space-y-4 text-sm text-white/50\" data-kid=\"196\">\n            <li data-kid=\"197\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"198\">Development</a></li>\n            <li data-kid=\"199\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"200\">Cloud</a></li>\n            <li data-kid=\"201\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"202\">Security</a></li>\n            <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"204\">Consulting</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"205\">\n          <h5 class=\"font-heading font-bold text-sm uppercase tracking-widest mb-6\" data-kid=\"206\">Legal</h5>\n          <ul class=\"space-y-4 text-sm text-white/50\" data-kid=\"207\">\n            <li data-kid=\"208\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"209\">Privacy Policy</a></li>\n            <li data-kid=\"210\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"211\">Terms of Service</a></li>\n            <li data-kid=\"212\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"213\">Security</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between text-xs text-white/30 font-bold uppercase tracking-widest\" data-kid=\"214\">\n      <p data-kid=\"215\">&copy; 2026 BROCUS IT SOLUTIONS. ALL RIGHTS RESERVED.</p>\n      <p data-kid=\"216\">ENGINEERED IN THE USA</p>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"217\"></script>\n<script data-kid=\"218\">\n  // Simple GSAP entrance animations\n  document.addEventListener('DOMContentLoaded', () => {\n    const tl = gsap.timeline();\n    \n    tl.from('nav', { y: -20, opacity: 0, duration: 0.8, ease: 'power3.out' })\n      .from('h1', { y: 30, opacity: 0, duration: 1, ease: 'power4.out' }, '-=0.4')\n      .from('h1 + p', { y: 20, opacity: 0, duration: 0.8 }, '-=0.6')\n      .from('.hero-blob', { scale: 0.5, opacity: 0, duration: 2, ease: 'power2.out' }, '-=1')\n      .from('.glass', { y: 40, opacity: 0, stagger: 0.15, duration: 1, ease: 'power3.out' }, '-=0.5');\n  });\n</script>",
