      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Manrope:wght@200..800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary: #8B5CF6;\n    --secondary: #FB923C;\n    --border: #e5e7eb;\n    --dot-color: #f3f4f6;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #ffffff;\n    color: #111827;\n    font-family: 'Manrope', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .dot-grid {\n    background-image: radial-gradient(#e5e7eb 1px, transparent 1px);\n    background-size: 16px 16px;\n  }\n\n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n\n  .blueprint-border {\n    border: 1px solid var(--border);\n  }\n\n  .tech-line {\n    height: 1px;\n    background-color: var(--border);\n    width: 100%;\n  }\n\n  .btn-primary {\n    background-color: var(--primary);\n    color: white;\n    border-radius: 8px;\n    transition: all 0.2s;\n  }\n  .btn-primary:hover {\n    background-color: #7C3AED;\n    transform: translateY(-1px);\n  }\n\n  .tech-card {\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .tech-card:hover {\n    border-color: var(--primary);\n    background-color: #f9fafb;\n  }\n\n  /* Specific sizing for hero image */\n  .hero-mask {\n    mask-image: linear-gradient(to bottom, black 50%, transparent);\n  }\n</style>\n\n<div class=\"relative min-h-screen dot-grid\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 px-12 py-5 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-8 h-8 bg-[#8B5CF6] rounded-md flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-atom-2 text-white\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-heading text-lg font-bold tracking-tight\" data-kid=\"6\">BROCUS</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-gray-500\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-[#8B5CF6] transition-colors\" data-kid=\"8\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-[#8B5CF6] transition-colors\" data-kid=\"9\">Infrastructure</a>\n      <a href=\"#\" class=\"hover:text-[#8B5CF6] transition-colors\" data-kid=\"10\">Security</a>\n      <a href=\"#\" class=\"hover:text-[#8B5CF6] transition-colors\" data-kid=\"11\">Company</a>\n    </div>\n    <div class=\"flex items-center gap-4\" data-kid=\"12\">\n      <button class=\"text-sm font-semibold text-gray-900\" data-kid=\"13\">Sign In</button>\n      <button class=\"px-5 py-2 btn-primary text-sm font-bold\" data-kid=\"14\">Initialize Project</button>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-32 pb-20 border-b border-gray-100 overflow-hidden\" data-kid=\"15\">\n    <div class=\"max-w-4xl mx-auto px-6 text-center relative z-10\" data-kid=\"16\">\n      <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-md bg-purple-50 border border-purple-100 text-[10px] font-bold tracking-widest text-[#8B5CF6] mb-6 uppercase\" data-kid=\"17\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8B5CF6] animate-pulse\" data-kid=\"18\"></span> Technical Excellence\n      </div>\n      <h1 class=\"font-heading text-6xl md:text-7xl font-bold leading-tight tracking-tighter text-gray-900 mb-8\" data-kid=\"19\">\n        Precision Engineered <br data-kid=\"20\"> <span class=\"text-[#8B5CF6]\" data-kid=\"158\">IT Infrastructure.</span>\n      </h1>\n      <p class=\"text-lg text-gray-500 max-w-xl mx-auto leading-relaxed mb-10\" data-kid=\"21\">\n        Building high-performance software, secure cloud architectures, and digital workflows with surgical precision.\n      </p>\n      \n      <div class=\"flex items-center justify-center gap-4\" data-kid=\"22\">\n        <button class=\"px-8 py-4 btn-primary font-bold\" data-kid=\"23\">Get Started</button>\n        <button class=\"px-8 py-4 border border-gray-200 rounded-md font-bold text-gray-700 hover:bg-gray-50 transition-colors\" data-kid=\"24\">View Case Studies</button>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-20 max-w-6xl mx-auto px-6 relative\" data-kid=\"25\">\n      <div class=\"blueprint-border rounded-xl overflow-hidden bg-white shadow-xs\" data-kid=\"26\">\n        <img src=\"https://images.pexels.com/photos/10988763/pexels-photo-10988763.jpeg?auto=format&w=1200&q=80&fit=crop\" alt=\"Modern Tech Office\" class=\"w-full h-[400px] object-cover grayscale opacity-30 mix-blend-multiply\" data-kid=\"27\" decoding=\"async\" loading=\"lazy\">\n        \n        <div class=\"absolute top-1/2 left-0 right-0 h-px bg-purple-500/20\" data-kid=\"28\"></div>\n        <div class=\"absolute top-0 bottom-0 left-1/2 w-px bg-purple-500/20\" data-kid=\"29\"></div>\n      </div>\n      \n      \n      <div class=\"absolute -top-4 -right-4 w-24 h-24 border-t-2 border-r-2 border-[#FB923C]/30\" data-kid=\"30\"></div>\n      <div class=\"absolute -bottom-4 -left-4 w-24 h-24 border-b-2 border-l-2 border-[#FB923C]/30\" data-kid=\"31\"></div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24 border-b border-gray-100\" data-kid=\"32\">\n    <div class=\"max-w-7xl mx-auto px-12\" data-kid=\"33\">\n      <div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-6\" data-kid=\"34\">\n        <div class=\"max-w-lg\" data-kid=\"35\">\n          <h2 class=\"font-heading text-4xl font-bold text-gray-900 mb-4\" data-kid=\"36\">Core Architecture</h2>\n          <p class=\"text-gray-500\" data-kid=\"37\">Modular services designed to scale with enterprise reliability and zero-trust security.</p>\n        </div>\n        <div class=\"flex gap-2\" data-kid=\"38\">\n          <div class=\"w-10 h-10 border border-gray-200 rounded-md flex items-center justify-center text-gray-400\" data-kid=\"39\"><i class=\"ti ti-chevron-left\" data-kid=\"40\"></i></div>\n          <div class=\"w-10 h-10 border border-gray-200 rounded-md flex items-center justify-center text-gray-900\" data-kid=\"41\"><i class=\"ti ti-chevron-right\" data-kid=\"42\"></i></div>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-0 border border-gray-100 rounded-lg overflow-hidden bg-white\" data-kid=\"43\">\n        \n        <div class=\"p-10 border-r border-gray-100 tech-card group\" data-kid=\"44\">\n          <div class=\"w-12 h-12 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-center mb-8 text-[#8B5CF6]\" data-kid=\"45\">\n            <i class=\"ti ti-cloud-storm text-2xl\" data-kid=\"46\"></i>\n          </div>\n          <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"47\">Cloud Scaling</h3>\n          <p class=\"text-sm text-gray-500 leading-relaxed mb-8\" data-kid=\"48\">Dynamic infrastructure management with automated load balancing and global distribution.</p>\n          <div class=\"flex items-center gap-2 text-xs font-bold text-[#8B5CF6] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"49\">\n            READ DOCS <i class=\"ti ti-arrow-right\" data-kid=\"50\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"p-10 border-r border-gray-100 tech-card group\" data-kid=\"51\">\n          <div class=\"w-12 h-12 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-center mb-8 text-[#FB923C]\" data-kid=\"52\">\n            <i class=\"ti ti-shield-check text-2xl\" data-kid=\"53\"></i>\n          </div>\n          <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"54\">Cyber Defense</h3>\n          <p class=\"text-sm text-gray-500 leading-relaxed mb-8\" data-kid=\"55\">Perimeter-less security models with real-time threat detection and automated response protocols.</p>\n          <div class=\"flex items-center gap-2 text-xs font-bold text-[#FB923C] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"56\">\n            SECURE ACCESS <i class=\"ti ti-arrow-right\" data-kid=\"57\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"p-10 tech-card group\" data-kid=\"58\">\n          <div class=\"w-12 h-12 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-center mb-8 text-blue-500\" data-kid=\"59\">\n            <i class=\"ti ti-code text-2xl\" data-kid=\"60\"></i>\n          </div>\n          <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"61\">API Engineering</h3>\n          <p class=\"text-sm text-gray-500 leading-relaxed mb-8\" data-kid=\"62\">Robust, type-safe integration layers built for high-concurrency environments and data integrity.</p>\n          <div class=\"flex items-center gap-2 text-xs font-bold text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"63\">\n            EXPLORE STACK <i class=\"ti ti-arrow-right\" data-kid=\"64\"></i>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24 border-b border-gray-100 bg-gray-50/50\" data-kid=\"65\">\n    <div class=\"max-w-7xl mx-auto px-12\" data-kid=\"66\">\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-20 items-center\" data-kid=\"67\">\n        <div data-kid=\"68\">\n          <h2 class=\"font-heading text-4xl font-bold text-gray-900 mb-8\" data-kid=\"69\">Operational Metrics</h2>\n          <div class=\"space-y-8\" data-kid=\"70\">\n            <div class=\"flex gap-6 items-start\" data-kid=\"71\">\n              <div class=\"font-heading text-3xl font-bold text-[#8B5CF6] w-24\" data-kid=\"72\">99.9%</div>\n              <div data-kid=\"73\">\n                <div class=\"font-bold text-gray-900 mb-1\" data-kid=\"74\">Uptime Guarantee</div>\n                <p class=\"text-sm text-gray-500\" data-kid=\"75\">SLA-backed performance for mission-critical enterprise applications.</p>\n              </div>\n            </div>\n            <div class=\"h-px bg-gray-200\" data-kid=\"76\"></div>\n            <div class=\"flex gap-6 items-start\" data-kid=\"77\">\n              <div class=\"font-heading text-3xl font-bold text-[#FB923C] w-24\" data-kid=\"78\">2.4ms</div>\n              <div data-kid=\"79\">\n                <div class=\"font-bold text-gray-900 mb-1\" data-kid=\"80\">Average Latency</div>\n                <p class=\"text-sm text-gray-500\" data-kid=\"81\">Highly optimized edge networks ensuring rapid data delivery worldwide.</p>\n              </div>\n            </div>\n            <div class=\"h-px bg-gray-200\" data-kid=\"82\"></div>\n            <div class=\"flex gap-6 items-start\" data-kid=\"83\">\n              <div class=\"font-heading text-3xl font-bold text-blue-500 w-24\" data-kid=\"84\">14k+</div>\n              <div data-kid=\"85\">\n                <div class=\"font-bold text-gray-900 mb-1\" data-kid=\"86\">Secured Nodes</div>\n                <p class=\"text-sm text-gray-500\" data-kid=\"87\">Active monitoring across our global infrastructure network.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"relative\" data-kid=\"88\">\n          <div class=\"blueprint-border rounded-lg p-8 bg-white shadow-sm\" data-kid=\"89\">\n            <div class=\"flex items-center justify-between mb-8\" data-kid=\"90\">\n              <div class=\"text-[10px] font-bold tracking-widest text-gray-400\" data-kid=\"91\">NETWORK_TOPOLOGY.XML</div>\n              <div class=\"flex gap-1\" data-kid=\"92\">\n                <div class=\"w-2 h-2 rounded-full bg-red-400\" data-kid=\"93\"></div>\n                <div class=\"w-2 h-2 rounded-full bg-yellow-400\" data-kid=\"94\"></div>\n                <div class=\"w-2 h-2 rounded-full bg-green-400\" data-kid=\"95\"></div>\n              </div>\n            </div>\n            <div class=\"space-y-4\" data-kid=\"96\">\n              <div class=\"h-2 bg-[#8B5CF6]/10 rounded-full w-3/4\" data-kid=\"97\"></div>\n              <div class=\"h-2 bg-[#8B5CF6]/5 rounded-full w-1/2\" data-kid=\"98\"></div>\n              <div class=\"h-2 bg-[#8B5CF6]/10 rounded-full w-5/6\" data-kid=\"99\"></div>\n              <div class=\"grid grid-cols-4 gap-2 py-4\" data-kid=\"100\">\n                <div class=\"aspect-square bg-gray-50 border border-gray-100 rounded-md\" data-kid=\"101\"></div>\n                <div class=\"aspect-square bg-gray-50 border border-gray-100 rounded-md\" data-kid=\"102\"></div>\n                <div class=\"aspect-square bg-[#FB923C]/10 border border-[#FB923C]/20 rounded-md\" data-kid=\"103\"></div>\n                <div class=\"aspect-square bg-gray-50 border border-gray-100 rounded-md\" data-kid=\"104\"></div>\n              </div>\n              <div class=\"h-2 bg-[#8B5CF6]/10 rounded-full w-full\" data-kid=\"105\"></div>\n              <div class=\"h-2 bg-[#8B5CF6]/5 rounded-full w-2/3\" data-kid=\"106\"></div>\n            </div>\n          </div>\n          \n          <div class=\"absolute -bottom-6 -right-6 p-4 bg-[#8B5CF6] text-white rounded-lg shadow-lg font-heading text-sm font-bold\" data-kid=\"107\">\n            STATUS: NOMINAL\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-12 bg-white\" data-kid=\"108\">\n    <div class=\"max-w-7xl mx-auto border-t border-gray-100 pt-20\" data-kid=\"109\">\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"110\">\n        <div class=\"md:col-span-1\" data-kid=\"111\">\n          <div class=\"flex items-center gap-3 mb-6\" data-kid=\"112\">\n            <div class=\"w-6 h-6 bg-[#8B5CF6] rounded-sm flex items-center justify-center\" data-kid=\"113\">\n              <i class=\"ti ti-atom-2 text-white text-xs\" data-kid=\"114\"></i>\n            </div>\n            <span class=\"font-heading text-lg font-bold tracking-tight\" data-kid=\"115\">BROCUS</span>\n          </div>\n          <p class=\"text-sm text-gray-500 leading-relaxed mb-6\" data-kid=\"116\">\n            Enterprise IT solutions for a digital-first world. Building the infrastructure of tomorrow, today.\n          </p>\n          <div class=\"flex gap-4\" data-kid=\"117\">\n            <div class=\"w-8 h-8 border border-gray-200 rounded-md flex items-center justify-center text-gray-400 hover:text-[#8B5CF6] transition-colors\" data-kid=\"118\"><i class=\"ti ti-brand-linkedin\" data-kid=\"119\"></i></div>\n            <div class=\"w-8 h-8 border border-gray-200 rounded-md flex items-center justify-center text-gray-400 hover:text-[#8B5CF6] transition-colors\" data-kid=\"120\"><i class=\"ti ti-brand-x\" data-kid=\"121\"></i></div>\n            <div class=\"w-8 h-8 border border-gray-200 rounded-md flex items-center justify-center text-gray-400 hover:text-[#8B5CF6] transition-colors\" data-kid=\"122\"><i class=\"ti ti-brand-github\" data-kid=\"123\"></i></div>\n          </div>\n        </div>\n        \n        <div data-kid=\"124\">\n          <h4 class=\"font-heading text-sm font-bold uppercase tracking-widest text-gray-900 mb-6\" data-kid=\"125\">Solutions</h4>\n          <ul class=\"space-y-4 text-sm text-gray-500\" data-kid=\"126\">\n            <li data-kid=\"127\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"128\">Cloud Architecture</a></li>\n            <li data-kid=\"129\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"130\">Security Operations</a></li>\n            <li data-kid=\"131\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"132\">Product Engineering</a></li>\n            <li data-kid=\"133\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"134\">Managed Services</a></li>\n          </ul>\n        </div>\n\n        <div data-kid=\"135\">\n          <h4 class=\"font-heading text-sm font-bold uppercase tracking-widest text-gray-900 mb-6\" data-kid=\"136\">Resources</h4>\n          <ul class=\"space-y-4 text-sm text-gray-500\" data-kid=\"137\">\n            <li data-kid=\"138\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"139\">Technical Docs</a></li>\n            <li data-kid=\"140\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"141\">System Status</a></li>\n            <li data-kid=\"142\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"143\">Open Source</a></li>\n            <li data-kid=\"144\"><a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"145\">Security Advisory</a></li>\n          </ul>\n        </div>\n\n        <div class=\"p-6 bg-gray-50 rounded-lg border border-gray-100\" data-kid=\"146\">\n          <h4 class=\"font-heading text-sm font-bold text-gray-900 mb-4\" data-kid=\"147\">Stay Informed</h4>\n          <p class=\"text-xs text-gray-500 mb-4\" data-kid=\"148\">Get technical updates and security alerts delivered to your inbox.</p>\n          <div class=\"relative\" data-kid=\"149\">\n            <input type=\"text\" placeholder=\"Email\" class=\"w-full bg-white border border-gray-200 rounded-md px-3 py-2 text-xs focus:outline-hidden focus:border-[#8B5CF6]\" data-kid=\"150\">\n            <button class=\"absolute right-1 top-1 bottom-1 px-3 bg-[#8B5CF6] text-white rounded text-[10px] font-bold\" data-kid=\"151\">JOIN</button>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"mt-20 pt-8 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] font-bold tracking-widest text-gray-400\" data-kid=\"152\">\n        <div data-kid=\"153\">© 2026 BROCUS IT SOLUTIONS USA</div>\n        <div class=\"flex gap-8\" data-kid=\"154\">\n          <a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"155\">PRIVACY_POLICY.MD</a>\n          <a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"156\">TERMS_OF_SERVICE.MD</a>\n          <a href=\"#\" class=\"hover:text-[#8B5CF6]\" data-kid=\"157\">SECURITY.TXT</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>",
