      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --purple: #8B5CF6;\n    --orange: #FB923C;\n    --bg: #050508;\n    --border: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    background-color: var(--bg);\n    color: #fff;\n    font-family: 'Manrope', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-tech { font-family: 'Space Grotesk', sans-serif; }\n\n  .grid-bg {\n    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n                      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .glass-panel {\n    background: rgba(255, 255, 255, 0.02);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--border);\n  }\n\n  .terminal-cursor {\n    display: inline-block;\n    width: 8px;\n    height: 1.2em;\n    background: var(--purple);\n    vertical-align: middle;\n    animation: blink 1s step-end infinite;\n    margin-left: 4px;\n  }\n\n  @keyframes blink {\n    50% { opacity: 0; }\n  }\n\n  .scanline {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(to bottom, transparent 50%, rgba(139, 92, 246, 0.05) 50%);\n    background-size: 100% 4px;\n    pointer-events: none;\n    z-index: 10;\n  }\n\n  .tech-gradient-text {\n    background: linear-gradient(135deg, #fff 0%, var(--purple) 50%, var(--orange) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n</style>\n\n<div class=\"min-h-screen grid-bg selection:bg-purple-500/30\" data-kid=\"1\">\n  \n  <nav class=\"flex items-center justify-between px-8 py-6 border-b border-white/5 bg-black/20 backdrop-blur-md sticky top-0 z-50\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-gradient-to-br from-purple-500 to-orange-400 rounded-lg flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-cpu text-white text-xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-tech text-xl font-bold tracking-tight\" data-kid=\"6\">BROCUS<span class=\"text-purple-400\" data-kid=\"7\">.SYSTEMS</span></span>\n    </div>\n    \n    <div class=\"hidden md:flex items-center gap-10 font-tech text-sm uppercase tracking-widest text-white/60\" data-kid=\"8\">\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"9\">Core_Engine</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Architecture</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Deployments</a>\n      <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Initialize</a>\n    </div>\n\n    <button class=\"font-tech border border-white/20 px-6 py-2 rounded-full text-sm font-medium hover:bg-white hover:text-black transition-all\" data-kid=\"13\">\n      RUN_SETUP()\n    </button>\n  </nav>\n\n  \n  <section class=\"relative pt-24 pb-32 px-8 overflow-hidden\" data-kid=\"14\">\n    \n    <div class=\"absolute top-0 right-0 w-[600px] h-[600px] bg-purple-600/10 blur-[150px] -z-10 rounded-full\" data-kid=\"15\"></div>\n    <div class=\"absolute bottom-0 left-0 w-[400px] h-[400px] bg-orange-500/5 blur-[120px] -z-10 rounded-full\" data-kid=\"16\"></div>\n\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"17\">\n      <div class=\"space-y-8\" data-kid=\"18\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-tech text-purple-400\" data-kid=\"19\">\n          <span class=\"w-2 h-2 rounded-full bg-purple-500 animate-pulse\" data-kid=\"20\"></span>\n          STABLE_BUILD_V3.0.4\n        </div>\n        \n        <h1 class=\"text-6xl lg:text-8xl font-tech font-bold leading-tight tracking-tighter\" data-kid=\"21\">\n          ENGINEERING <br data-kid=\"22\">\n          <span class=\"tech-gradient-text\" data-kid=\"23\">THE FUTURE</span> <br data-kid=\"24\">\n          OF IT.\n        </h1>\n        \n        <p class=\"text-lg text-white/50 max-w-lg leading-relaxed\" data-kid=\"25\">\n          Scalable software development, iron-clad cloud security, and robust architecture \n          calculated for enterprise-grade performance.\n        </p>\n        \n        <div class=\"flex flex-wrap gap-4\" data-kid=\"26\">\n          <button class=\"bg-purple-600 hover:bg-purple-500 text-white font-tech px-8 py-4 rounded-lg flex items-center gap-3 transition-all group\" data-kid=\"27\">\n            INITIALIZE_PROJECT\n            <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"28\"></i>\n          </button>\n          <button class=\"glass-panel hover:bg-white/10 text-white font-tech px-8 py-4 rounded-lg transition-all\" data-kid=\"29\">\n            READ_DOCUMENTATION\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"relative group\" data-kid=\"30\">\n        <div class=\"absolute -inset-1 bg-gradient-to-r from-purple-500/20 to-orange-500/20 rounded-2xl blur-lg opacity-75 group-hover:opacity-100 transition duration-1000\" data-kid=\"31\"></div>\n        <div class=\"relative glass-panel rounded-2xl overflow-hidden shadow-2xl\" data-kid=\"32\">\n          \n          <div class=\"bg-white/5 px-4 py-3 border-b border-white/10 flex items-center justify-between\" data-kid=\"33\">\n            <div class=\"flex gap-1.5\" data-kid=\"34\">\n              <div class=\"w-3 h-3 rounded-full bg-red-500/50\" data-kid=\"35\"></div>\n              <div class=\"w-3 h-3 rounded-full bg-yellow-500/50\" data-kid=\"36\"></div>\n              <div class=\"w-3 h-3 rounded-full bg-green-500/50\" data-kid=\"37\"></div>\n            </div>\n            <div class=\"text-[10px] font-tech text-white/30 tracking-widest uppercase\" data-kid=\"38\">\n              Brocus_Core_Terminal\n            </div>\n          </div>\n          \n          <div class=\"relative aspect-video\" data-kid=\"39\">\n            <img src=\"https://images.unsplash.com/photo-1684675151061-62526b463983?auto=format&w=800&q=80&fit=crop\" alt=\"Microchip background\" class=\"absolute inset-0 w-full h-full object-cover opacity-20\" decoding=\"async\" loading=\"lazy\" data-kid=\"40\">\n            <div class=\"scanline\" data-kid=\"41\"></div>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent\" data-kid=\"42\"></div>\n            \n            <div class=\"absolute inset-0 p-6 font-tech text-xs md:text-sm text-purple-400 space-y-1.5 overflow-hidden\" data-kid=\"43\">\n              <div class=\"flex gap-2\" data-kid=\"44\">\n                <span class=\"text-white/40\" data-kid=\"45\">[ 0.000000]</span>\n                <span data-kid=\"46\">Initializing brocus-kernel-v3...</span>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"47\">\n                <span class=\"text-white/40\" data-kid=\"48\">[ 0.041021]</span>\n                <span data-kid=\"49\">CPU: Brocus Enterprise Optimized @ 5.4GHz</span>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"50\">\n                <span class=\"text-white/40\" data-kid=\"51\">[ 0.125842]</span>\n                <span class=\"text-white\" data-kid=\"52\">Loading secure_cloud_infrastructure... SUCCESS</span>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"53\">\n                <span class=\"text-white/40\" data-kid=\"54\">[ 0.485125]</span>\n                <span class=\"text-white\" data-kid=\"55\">Connecting to AWS/Azure Global Grid... OK</span>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"56\">\n                <span class=\"text-white/40\" data-kid=\"57\">[ 0.952147]</span>\n                <span class=\"text-orange-400\" data-kid=\"58\">WARNING: Optimized protocols detected.</span>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"59\">\n                <span class=\"text-white/40\" data-kid=\"60\">[ 1.254189]</span>\n                <span class=\"text-green-400\" data-kid=\"61\">Starting UI_SYSTEM... ONLINE</span>\n              </div>\n              <div class=\"pt-4 flex items-center text-white/90\" data-kid=\"62\">\n                <span class=\"mr-2\" data-kid=\"63\">> root@brocus:~$</span>\n                <span data-kid=\"64\">deploy_full_stack_solutions --env production</span>\n                <span class=\"terminal-cursor\" data-kid=\"65\"></span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 border-t border-white/5\" data-kid=\"66\">\n    <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"67\">\n      <div class=\"flex flex-col lg:flex-row gap-16\" data-kid=\"68\">\n        \n        <div class=\"lg:w-1/3 space-y-4\" data-kid=\"69\">\n          <h2 class=\"text-3xl font-tech font-bold mb-8\" data-kid=\"70\">SYSTEM_SPECS</h2>\n          <div class=\"space-y-2\" data-kid=\"71\">\n            <button class=\"w-full text-left p-6 rounded-xl bg-purple-500/10 border-l-4 border-purple-500 font-tech\" data-kid=\"72\">\n              <div class=\"text-xs text-purple-400 mb-1\" data-kid=\"73\">MODULE_01</div>\n              <div class=\"text-xl font-bold\" data-kid=\"74\">SOFTWARE_ENGINERING</div>\n            </button>\n            <button class=\"w-full text-left p-6 rounded-xl border border-white/5 hover:bg-white/5 transition-all font-tech group\" data-kid=\"75\">\n              <div class=\"text-xs text-white/40 mb-1\" data-kid=\"76\">MODULE_02</div>\n              <div class=\"text-xl font-bold group-hover:text-white transition-colors\" data-kid=\"77\">CLOUD_INFRASTRUCTURE</div>\n            </button>\n            <button class=\"w-full text-left p-6 rounded-xl border border-white/5 hover:bg-white/5 transition-all font-tech group\" data-kid=\"78\">\n              <div class=\"text-xs text-white/40 mb-1\" data-kid=\"79\">MODULE_03</div>\n              <div class=\"text-xl font-bold group-hover:text-white transition-colors\" data-kid=\"80\">SECURITY_ARCHITECTURE</div>\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"lg:w-2/3\" data-kid=\"81\">\n          <div class=\"glass-panel p-10 rounded-3xl relative overflow-hidden h-full\" data-kid=\"82\">\n            <div class=\"absolute top-0 right-0 p-4\" data-kid=\"83\">\n              <i class=\"ti ti-code text-8xl text-white/5\" data-kid=\"84\"></i>\n            </div>\n            \n            <div class=\"space-y-8\" data-kid=\"85\">\n              <h3 class=\"text-4xl font-tech font-bold\" data-kid=\"86\">FULL_STACK_DEVELOPMENT</h3>\n              <p class=\"text-white/60 leading-relaxed text-lg max-w-xl\" data-kid=\"87\">\n                We engineer high-performance web and mobile applications using modern tech stacks \n                designed for scalability and maintainability. Our code is peer-reviewed and \n                automated for continuous deployment.\n              </p>\n              \n              <div class=\"grid grid-cols-2 md:grid-cols-3 gap-6 pt-8\" data-kid=\"88\">\n                <div class=\"p-4 border border-white/10 rounded-lg font-tech text-xs bg-white/2\" data-kid=\"89\">\n                  <div class=\"text-white/40 mb-2\" data-kid=\"90\">FRAMEWORK</div>\n                  <div class=\"text-purple-400 font-bold\" data-kid=\"91\">REACT / NEXT.JS</div>\n                </div>\n                <div class=\"p-4 border border-white/10 rounded-lg font-tech text-xs bg-white/2\" data-kid=\"92\">\n                  <div class=\"text-white/40 mb-2\" data-kid=\"93\">BACKEND</div>\n                  <div class=\"text-purple-400 font-bold\" data-kid=\"94\">NODE.JS / PYTHON</div>\n                </div>\n                <div class=\"p-4 border border-white/10 rounded-lg font-tech text-xs bg-white/2\" data-kid=\"95\">\n                  <div class=\"text-white/40 mb-2\" data-kid=\"96\">DATABASE</div>\n                  <div class=\"text-purple-400 font-bold\" data-kid=\"97\">POSTGRES / MONGODB</div>\n                </div>\n                <div class=\"p-4 border border-white/10 rounded-lg font-tech text-xs bg-white/2\" data-kid=\"98\">\n                  <div class=\"text-white/40 mb-2\" data-kid=\"99\">DEVOPS</div>\n                  <div class=\"text-purple-400 font-bold\" data-kid=\"100\">DOCKER / CI-CD</div>\n                </div>\n                <div class=\"p-4 border border-white/10 rounded-lg font-tech text-xs bg-white/2\" data-kid=\"101\">\n                  <div class=\"text-white/40 mb-2\" data-kid=\"102\">TESTING</div>\n                  <div class=\"text-purple-400 font-bold\" data-kid=\"103\">JEST / CYPRESS</div>\n                </div>\n                <div class=\"p-4 border border-white/10 rounded-lg font-tech text-xs bg-white/2\" data-kid=\"104\">\n                  <div class=\"text-white/40 mb-2\" data-kid=\"105\">MOBILE</div>\n                  <div class=\"text-purple-400 font-bold\" data-kid=\"106\">FLUTTER / SWIFT</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-black/40\" data-kid=\"107\">\n    <div class=\"max-w-7xl mx-auto px-8 text-center space-y-16\" data-kid=\"108\">\n      <div class=\"space-y-4\" data-kid=\"109\">\n        <h2 class=\"text-sm font-tech text-orange-400 tracking-[0.3em] uppercase\" data-kid=\"110\">Security_Protocol</h2>\n        <h3 class=\"text-5xl font-tech font-bold\" data-kid=\"111\">CYBER_ARCHITECTURE_BLUEPRINT</h3>\n      </div>\n\n      <div class=\"relative flex flex-col md:flex-row items-center justify-between gap-12 py-12\" data-kid=\"112\">\n        \n        <div class=\"hidden md:block absolute top-1/2 left-1/4 right-1/4 h-[1px] bg-gradient-to-r from-purple-500/50 via-orange-500 to-purple-500/50 -translate-y-1/2 -z-10\" data-kid=\"113\"></div>\n        \n        \n        <div class=\"glass-panel w-full md:w-64 p-8 rounded-2xl border-orange-500/30\" data-kid=\"114\">\n          <div class=\"w-12 h-12 bg-orange-500/20 rounded-lg flex items-center justify-center mx-auto mb-6\" data-kid=\"115\">\n            <i class=\"ti ti-device-desktop text-orange-400 text-2xl\" data-kid=\"116\"></i>\n          </div>\n          <h4 class=\"font-tech font-bold mb-2\" data-kid=\"117\">ENDPOINT_SHIELD</h4>\n          <p class=\"text-[10px] text-white/40 uppercase tracking-tighter\" data-kid=\"118\">Secure workstation protection</p>\n        </div>\n\n        <div class=\"glass-panel w-full md:w-80 p-10 rounded-2xl border-purple-500/50 scale-110 shadow-[0_0_50px_rgba(139,92,246,0.15)] bg-purple-500/5\" data-kid=\"119\">\n          <div class=\"w-16 h-16 bg-purple-500/20 rounded-full flex items-center justify-center mx-auto mb-6 border border-purple-500/30\" data-kid=\"120\">\n            <i class=\"ti ti-shield-check text-purple-400 text-3xl\" data-kid=\"121\"></i>\n          </div>\n          <h4 class=\"font-tech font-bold text-lg mb-2\" data-kid=\"122\">CORE_NETWORK_FIREWALL</h4>\n          <p class=\"text-[10px] text-purple-400 uppercase tracking-widest font-bold\" data-kid=\"123\">Active intrusion detection</p>\n        </div>\n\n        <div class=\"glass-panel w-full md:w-64 p-8 rounded-2xl border-orange-500/30\" data-kid=\"124\">\n          <div class=\"w-12 h-12 bg-orange-500/20 rounded-lg flex items-center justify-center mx-auto mb-6\" data-kid=\"125\">\n            <i class=\"ti ti-database text-orange-400 text-2xl\" data-kid=\"126\"></i>\n          </div>\n          <h4 class=\"font-tech font-bold mb-2\" data-kid=\"127\">ENCRYPTED_VAULT</h4>\n          <p class=\"text-[10px] text-white/40 uppercase tracking-tighter\" data-kid=\"128\">Zero-trust data storage</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8\" data-kid=\"129\">\n    <div class=\"max-w-7xl mx-auto space-y-16\" data-kid=\"130\">\n      <div class=\"flex justify-between items-end\" data-kid=\"131\">\n        <div class=\"space-y-4\" data-kid=\"132\">\n          <h2 class=\"text-sm font-tech text-purple-400 tracking-[0.3em] uppercase\" data-kid=\"133\">Case_History</h2>\n          <h3 class=\"text-5xl font-tech font-bold\" data-kid=\"134\">LATEST_DEPLOYMENTS</h3>\n        </div>\n        <a href=\"#\" class=\"font-tech text-sm text-white/40 hover:text-white transition-colors underline underline-offset-8\" data-kid=\"135\">VIEW_ALL_LOGS()</a>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"136\">\n        \n        <div class=\"group relative\" data-kid=\"137\">\n          <div class=\"glass-panel rounded-2xl overflow-hidden transition-all group-hover:-translate-y-2 border-white/5 group-hover:border-purple-500/30\" data-kid=\"138\">\n            <div class=\"aspect-video relative\" data-kid=\"139\">\n              <img src=\"https://images.unsplash.com/photo-1596890697706-fe174d6aa4f4?auto=format&w=800&q=80&fit=crop\" alt=\"Deployment wireframe\" class=\"w-full h-full object-cover opacity-40 mix-blend-luminosity group-hover:mix-blend-normal group-hover:opacity-100 transition-all duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"140\">\n              <div class=\"absolute inset-0 bg-gradient-to-t from-black to-transparent\" data-kid=\"141\"></div>\n            </div>\n            <div class=\"p-8 space-y-4\" data-kid=\"142\">\n              <div class=\"font-tech text-purple-400 text-[10px] tracking-widest uppercase\" data-kid=\"143\">Fintech_Solution</div>\n              <h4 class=\"text-xl font-bold font-tech\" data-kid=\"144\">SECURE_PAY_API</h4>\n              <p class=\"text-white/40 text-sm\" data-kid=\"145\">Engineered a high-availability payment gateway with zero-downtime architecture.</p>\n              <div class=\"pt-4 flex items-center gap-4 text-xs font-tech text-white/60\" data-kid=\"146\">\n                <span class=\"flex items-center gap-1\" data-kid=\"147\"><i class=\"ti ti-clock\" data-kid=\"148\"></i> 3_MONTHS</span>\n                <span class=\"flex items-center gap-1\" data-kid=\"149\"><i class=\"ti ti-stack\" data-kid=\"150\"></i> NODE/NEXT/POSTGRES</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group relative\" data-kid=\"151\">\n          <div class=\"glass-panel rounded-2xl overflow-hidden transition-all group-hover:-translate-y-2 border-white/5 group-hover:border-purple-500/30\" data-kid=\"152\">\n            <div class=\"aspect-video relative\" data-kid=\"153\">\n              <img src=\"https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&w=800&q=80&fit=crop\" alt=\"Deployment wireframe\" class=\"w-full h-full object-cover opacity-40 mix-blend-luminosity group-hover:mix-blend-normal group-hover:opacity-100 transition-all duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"154\">\n              <div class=\"absolute inset-0 bg-gradient-to-t from-black to-transparent\" data-kid=\"155\"></div>\n            </div>\n            <div class=\"p-8 space-y-4\" data-kid=\"156\">\n              <div class=\"font-tech text-purple-400 text-[10px] tracking-widest uppercase\" data-kid=\"157\">Health_Tech</div>\n              <h4 class=\"text-xl font-bold font-tech\" data-kid=\"158\">CLINIC_SYNERGY_AI</h4>\n              <p class=\"text-white/40 text-sm\" data-kid=\"159\">Automated patient management system with predictive resource allocation.</p>\n              <div class=\"pt-4 flex items-center gap-4 text-xs font-tech text-white/60\" data-kid=\"160\">\n                <span class=\"flex items-center gap-1\" data-kid=\"161\"><i class=\"ti ti-clock\" data-kid=\"162\"></i> 5_MONTHS</span>\n                <span class=\"flex items-center gap-1\" data-kid=\"163\"><i class=\"ti ti-stack\" data-kid=\"164\"></i> PYTHON/K8S/AZURE</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group relative\" data-kid=\"165\">\n          <div class=\"glass-panel rounded-2xl overflow-hidden transition-all group-hover:-translate-y-2 border-white/5 group-hover:border-purple-500/30\" data-kid=\"166\">\n            <div class=\"aspect-video relative\" data-kid=\"167\">\n              <img src=\"https://images.unsplash.com/photo-1755538497211-c4ebc7cc1a94?auto=format&w=800&q=80&fit=crop\" alt=\"Deployment wireframe\" class=\"w-full h-full object-cover opacity-40 mix-blend-luminosity group-hover:mix-blend-normal group-hover:opacity-100 transition-all duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"168\">\n              <div class=\"absolute inset-0 bg-gradient-to-t from-black to-transparent\" data-kid=\"169\"></div>\n            </div>\n            <div class=\"p-8 space-y-4\" data-kid=\"170\">\n              <div class=\"font-tech text-purple-400 text-[10px] tracking-widest uppercase\" data-kid=\"171\">E-Commerce</div>\n              <h4 class=\"text-xl font-bold font-tech\" data-kid=\"172\">GLOBAL_CART_SCALE</h4>\n              <p class=\"text-white/40 text-sm\" data-kid=\"173\">Infrastructure migration for global retailer supporting 1M+ concurrent users.</p>\n              <div class=\"pt-4 flex items-center gap-4 text-xs font-tech text-white/60\" data-kid=\"174\">\n                <span class=\"flex items-center gap-1\" data-kid=\"175\"><i class=\"ti ti-clock\" data-kid=\"176\"></i> 8_MONTHS</span>\n                <span class=\"flex items-center gap-1\" data-kid=\"177\"><i class=\"ti ti-stack\" data-kid=\"178\"></i> AWS/SERVERLESS/REACT</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-8 relative\" data-kid=\"179\">\n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-purple-500/10 blur-[150px] -z-10 rounded-full\" data-kid=\"180\"></div>\n    \n    <div class=\"max-w-4xl mx-auto glass-panel p-1 border-white/10 rounded-2xl overflow-hidden\" data-kid=\"181\">\n      <div class=\"bg-black/60 p-8 md:p-16 text-center space-y-10\" data-kid=\"182\">\n        <div class=\"space-y-4\" data-kid=\"183\">\n          <div class=\"font-tech text-purple-400 uppercase tracking-widest text-sm\" data-kid=\"184\">ready_to_deploy?</div>\n          <h2 class=\"text-4xl md:text-6xl font-tech font-bold\" data-kid=\"185\">READY TO INITIALIZE <br data-kid=\"186\"> YOUR SYSTEM?</h2>\n        </div>\n        \n        <div class=\"font-tech text-lg md:text-2xl text-white/60 border-l-2 border-purple-500 pl-6 py-4 mx-auto max-w-fit text-left\" data-kid=\"187\">\n          <span data-kid=\"188\">> root@brocus:~$ </span>\n          <span class=\"text-white\" data-kid=\"189\">./contact_us --urgent</span>\n          <span class=\"terminal-cursor\" data-kid=\"190\"></span>\n        </div>\n\n        <button class=\"bg-white text-black font-tech font-bold px-12 py-5 rounded-lg text-lg hover:bg-purple-500 hover:text-white transition-all transform hover:scale-105\" data-kid=\"191\">\n          INITIALIZE_CONTACT()\n        </button>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-8 border-t border-white/5\" data-kid=\"192\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"193\">\n      <div class=\"space-y-6\" data-kid=\"194\">\n        <div class=\"flex items-center gap-2\" data-kid=\"195\">\n          <div class=\"w-8 h-8 bg-gradient-to-br from-purple-500 to-orange-400 rounded flex items-center justify-center\" data-kid=\"196\">\n            <i class=\"ti ti-cpu text-white text-lg\" data-kid=\"197\"></i>\n          </div>\n          <span class=\"font-tech text-lg font-bold tracking-tight\" data-kid=\"198\">BROCUS</span>\n        </div>\n        <p class=\"text-sm text-white/40 leading-relaxed\" data-kid=\"199\">\n          High-performance IT solutions engineered for the modern enterprise.\n        </p>\n      </div>\n      \n      <div class=\"space-y-6\" data-kid=\"200\">\n        <h5 class=\"font-tech font-bold text-xs uppercase tracking-widest text-white/80\" data-kid=\"201\">Services</h5>\n        <ul class=\"space-y-3 text-sm text-white/40 font-tech\" data-kid=\"202\">\n          <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"204\">Software_Dev</a></li>\n          <li data-kid=\"205\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"206\">Cloud_Arch</a></li>\n          <li data-kid=\"207\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"208\">Cyber_Sec</a></li>\n          <li data-kid=\"209\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"210\">Managed_IT</a></li>\n        </ul>\n      </div>\n\n      <div class=\"space-y-6\" data-kid=\"211\">\n        <h5 class=\"font-tech font-bold text-xs uppercase tracking-widest text-white/80\" data-kid=\"212\">Company</h5>\n        <ul class=\"space-y-3 text-sm text-white/40 font-tech\" data-kid=\"213\">\n          <li data-kid=\"214\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"215\">About_System</a></li>\n          <li data-kid=\"216\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"217\">Team_Config</a></li>\n          <li data-kid=\"218\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"219\">Deployment_Logs</a></li>\n          <li data-kid=\"220\"><a href=\"#\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"221\">Initialize_Contact</a></li>\n        </ul>\n      </div>\n\n      <div class=\"space-y-6 text-right\" data-kid=\"222\">\n        <h5 class=\"font-tech font-bold text-xs uppercase tracking-widest text-white/80\" data-kid=\"223\">System_Status</h5>\n        <div class=\"text-sm text-green-400 font-tech\" data-kid=\"224\">ALL_SYSTEMS_OPERATIONAL</div>\n        <div class=\"text-[10px] text-white/20 font-tech\" data-kid=\"225\">© 2026 BROCUS IT SOLUTIONS USA</div>\n      </div>\n    </div>\n  </footer>\n</div>",
