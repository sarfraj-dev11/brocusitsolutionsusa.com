      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Manrope:wght@200..800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #ffffff;\n    --text-primary: #0a0a0a;\n    --text-secondary: #4a4a4a;\n    --purple: #8B5CF6;\n    --orange: #FB923C;\n    --glass: rgba(0, 0, 0, 0.015);\n    --glass-border: rgba(0, 0, 0, 0.05);\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--bg-base);\n    color: var(--text-primary);\n    font-family: 'Manrope', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n  \n  .glass-card {\n    background: var(--glass);\n    backdrop-filter: blur(20px);\n    border: 1px solid var(--glass-border);\n    border-radius: 24px;\n    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.05);\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .glass-card:hover {\n    transform: translateY(-8px);\n    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.1);\n    border-color: rgba(139, 92, 246, 0.2);\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, #0a0a0a 20%, var(--purple) 60%, var(--orange) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .blurred-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: -1;\n    opacity: 0.1;\n  }\n\n  @keyframes slowFloat {\n    0%, 100% { transform: translate(0, 0); }\n    50% { transform: translate(-20px, 30px); }\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div class=\"blurred-orb w-[600px] h-[600px] bg-[#8B5CF6] top-[-200px] left-[-100px] animate-[slowFloat_15s_infinite]\" data-kid=\"2\"></div>\n  <div class=\"blurred-orb w-[500px] h-[500px] bg-[#FB923C] bottom-[-100px] right-[-100px] animate-[slowFloat_20s_infinite_reverse]\" data-kid=\"3\"></div>\n\n  \n  <nav class=\"fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-12 py-6 backdrop-blur-md bg-white/70 border-b border-black/5\" data-kid=\"4\">\n    <div class=\"flex items-center gap-3\" data-kid=\"5\">\n      <img src=\"/api/local/images/assets/images/logo.png\" alt=\"Brocus Logo\" class=\"h-10 w-auto\" data-kid=\"6\">\n      <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"7\">BROCUS</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-10 text-sm font-medium text-black/60\" data-kid=\"8\">\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"9\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"10\">Services</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"11\">Impact</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"12\">About</a>\n    </div>\n    <button class=\"px-6 py-2.5 bg-black text-white font-semibold rounded-full hover:bg-black/80 transition-all active:scale-95 shadow-lg shadow-black/10\" data-kid=\"13\">\n      Start Project\n    </button>\n  </nav>\n\n  \n  <section class=\"relative h-screen flex flex-col items-center justify-center text-center px-6\" data-kid=\"14\">\n    <div class=\"relative z-10 max-w-5xl\" data-kid=\"15\">\n      <div class=\"inline-flex items-center px-4 py-1.5 rounded-full bg-black/[0.03] border border-black/[0.05] text-xs font-semibold tracking-widest text-black/40 mb-8 uppercase\" data-kid=\"16\">\n        Supercharging Enterprise IT\n      </div>\n      <h1 class=\"font-heading text-7xl md:text-9xl font-bold leading-[0.9] tracking-tighter gradient-text mb-8\" data-kid=\"17\">\n        The Future <br data-kid=\"18\"> of Tech is Minimal\n      </h1>\n      <p class=\"text-xl md:text-2xl text-black/50 max-w-2xl mx-auto leading-relaxed mb-12\" data-kid=\"19\">\n        We craft high-performance software, secure cloud architectures, and digital experiences that define modern excellence.\n      </p>\n      \n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\" data-kid=\"20\">\n        <div class=\"relative w-full max-w-md\" data-kid=\"21\">\n          <input type=\"email\" placeholder=\"Enter your business email\" class=\"w-full px-8 py-4 bg-black/[0.02] border border-black/10 rounded-full focus:outline-hidden focus:ring-2 focus:ring-[#8B5CF6]/20 transition-all shadow-inner\" data-kid=\"22\">\n          <button class=\"absolute right-2 top-2 bottom-2 px-6 bg-[#8B5CF6] text-white font-bold rounded-full hover:bg-[#7C3AED] transition-colors shadow-lg shadow-[#8B5CF6]/20\" data-kid=\"23\">\n            Connect\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 max-w-7xl mx-auto\" data-kid=\"24\">\n    <div class=\"mb-16 text-center\" data-kid=\"25\">\n      <h2 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"26\">Precision Engineered Solutions</h2>\n      <p class=\"text-black/40\" data-kid=\"27\">From discovery to deployment, we build what matters.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[320px]\" data-kid=\"28\">\n      \n      <div class=\"md:col-span-2 md:row-span-2 glass-card p-12 flex flex-col justify-between group relative overflow-hidden\" data-kid=\"29\">\n        <div class=\"relative z-10\" data-kid=\"30\">\n          <div class=\"w-14 h-14 rounded-2xl bg-[#8B5CF6]/10 flex items-center justify-center mb-8\" data-kid=\"31\">\n            <i class=\"ti ti-cloud-bolt text-3xl text-[#8B5CF6]\" data-kid=\"32\"></i>\n          </div>\n          <h3 class=\"font-heading text-4xl font-bold mb-6\" data-kid=\"33\">Cloud Migration & Scaling</h3>\n          <p class=\"text-black/50 text-xl max-w-md leading-relaxed\" data-kid=\"34\">\n            Zero-downtime infrastructure shifts that grow with your user base. Automated scaling for global resilience.\n          </p>\n        </div>\n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/waves.svg\" class=\"absolute bottom-[-60px] right-[-60px] w-96 h-96 opacity-5 pointer-events-none group-hover:opacity-10 transition-all duration-1000 grayscale\" style=\"color: #8B5CF6;\" data-kid=\"35\">\n             \n        <div class=\"relative z-10 flex items-center gap-4 text-sm font-bold text-[#8B5CF6] mt-8 cursor-pointer group-hover:gap-6 transition-all\" data-kid=\"36\">\n          EXPLORE ARCHITECTURE <i class=\"ti ti-arrow-right\" data-kid=\"37\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"glass-card p-10 flex flex-col justify-between group\" data-kid=\"38\">\n        <div data-kid=\"39\">\n          <div class=\"w-12 h-12 rounded-xl bg-[#FB923C]/10 flex items-center justify-center mb-6\" data-kid=\"40\">\n            <i class=\"ti ti-shield-check text-2xl text-[#FB923C]\" data-kid=\"41\"></i>\n          </div>\n          <h3 class=\"font-heading text-2xl font-bold mb-3\" data-kid=\"42\">Zero-Trust Security</h3>\n          <p class=\"text-black/40 text-sm leading-relaxed\" data-kid=\"43\">Enterprise-grade protection for every endpoint and connection.</p>\n        </div>\n        <div class=\"text-[10px] font-bold text-black/20 tracking-widest mt-4\" data-kid=\"44\">ACTIVE PROTECTION</div>\n      </div>\n\n      \n      <div class=\"glass-card p-10 flex flex-col justify-between group\" data-kid=\"45\">\n        <div data-kid=\"46\">\n          <div class=\"w-12 h-12 rounded-xl bg-[#8B5CF6]/10 flex items-center justify-center mb-6\" data-kid=\"47\">\n            <i class=\"ti ti-code text-2xl text-[#8B5CF6]\" data-kid=\"48\"></i>\n          </div>\n          <h3 class=\"font-heading text-2xl font-bold mb-3\" data-kid=\"49\">Custom Software</h3>\n          <p class=\"text-black/40 text-sm leading-relaxed\" data-kid=\"50\">Bespoke digital tools tailored specifically for your workflow.</p>\n        </div>\n        <div class=\"text-[10px] font-bold text-black/20 tracking-widest mt-4\" data-kid=\"51\">INITIALIZE REPO</div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-48 overflow-hidden bg-black/[0.01]\" data-kid=\"52\">\n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"53\">\n      <span class=\"font-heading text-[30vw] font-black text-black/[0.02] leading-none select-none\" data-kid=\"54\">99.9%</span>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto px-12 relative z-10\" data-kid=\"55\">\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-16 text-center\" data-kid=\"56\">\n        <div data-kid=\"57\">\n          <div class=\"font-heading text-6xl font-bold mb-3 text-[#8B5CF6]\" data-kid=\"58\">99.9%</div>\n          <div class=\"text-xs text-black/30 uppercase tracking-[0.2em] font-bold\" data-kid=\"59\">Platform Uptime</div>\n        </div>\n        <div data-kid=\"60\">\n          <div class=\"font-heading text-6xl font-bold mb-3 text-black\" data-kid=\"61\">2.4PB</div>\n          <div class=\"text-xs text-black/30 uppercase tracking-[0.2em] font-bold\" data-kid=\"62\">Data Managed</div>\n        </div>\n        <div data-kid=\"63\">\n          <div class=\"font-heading text-6xl font-bold mb-3 text-[#FB923C]\" data-kid=\"64\">0</div>\n          <div class=\"text-xs text-black/30 uppercase tracking-[0.2em] font-bold\" data-kid=\"65\">Security Breaches</div>\n        </div>\n        <div data-kid=\"66\">\n          <div class=\"font-heading text-6xl font-bold mb-3 text-black\" data-kid=\"67\">500+</div>\n          <div class=\"text-xs text-black/30 uppercase tracking-[0.2em] font-bold\" data-kid=\"68\">Happy Partners</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-12 overflow-hidden\" data-kid=\"69\">\n    <div class=\"max-w-7xl mx-auto mb-20\" data-kid=\"70\">\n      <h2 class=\"font-heading text-5xl font-bold mb-4\" data-kid=\"71\">Trusted by Industry Leaders</h2>\n      <p class=\"text-black/40 text-lg\" data-kid=\"72\">Engineering success stories across the globe.</p>\n    </div>\n\n    <div class=\"flex gap-10 overflow-x-auto pb-12 scrollbar-none px-4\" data-kid=\"73\">\n      \n      <div class=\"glass-card p-12 min-w-[480px] relative group\" data-kid=\"74\">\n        <i class=\"ti ti-quote text-7xl text-black/[0.03] absolute top-6 right-6 group-hover:text-[#8B5CF6]/10 transition-colors\" data-kid=\"75\"></i>\n        <p class=\"text-xl text-black/70 leading-relaxed mb-12 italic\" data-kid=\"76\">\n          \"Brocus transformed our legacy infrastructure into a cloud-native powerhouse in under 3 months. Their attention to security is unmatched.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"77\">\n          <img src=\"https://i.pravatar.cc/120?u=sarah\" class=\"w-14 h-14 rounded-full grayscale group-hover:grayscale-0 transition-all shadow-lg shadow-black/5\" data-kid=\"78\">\n          <div data-kid=\"79\">\n            <div class=\"font-bold text-lg\" data-kid=\"80\">Sarah Chen</div>\n            <div class=\"text-xs text-black/40 font-semibold tracking-wide uppercase\" data-kid=\"81\">CTO, Vertex Scale</div>\n          </div>\n        </div>\n      </div>\n      \n      \n      <div class=\"glass-card p-12 min-w-[480px] relative group\" data-kid=\"82\">\n        <i class=\"ti ti-quote text-7xl text-black/[0.03] absolute top-6 right-6 group-hover:text-[#FB923C]/10 transition-colors\" data-kid=\"83\"></i>\n        <p class=\"text-xl text-black/70 leading-relaxed mb-12 italic\" data-kid=\"84\">\n          \"The most professional development partner we've worked with. The design is clean, minimal, and perfectly aligned with our brand.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"85\">\n          <img src=\"https://i.pravatar.cc/120?u=james\" class=\"w-14 h-14 rounded-full grayscale group-hover:grayscale-0 transition-all shadow-lg