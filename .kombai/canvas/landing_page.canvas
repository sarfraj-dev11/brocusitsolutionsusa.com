      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Manrope:wght@200..800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #f9fafb;\n    --purple: #8B5CF6;\n    --orange: #FB923C;\n    --text-main: #111827;\n    --text-muted: #6b7280;\n    --card-bg: #ffffff;\n    --ghost-border: rgba(0, 0, 0, 0.05);\n    /* Multi-layered floating shadow */\n    --shadow-floating: 0 10px 15px -3px rgba(0, 0, 0, 0.04), 0 4px 6px -4px rgba(0, 0, 0, 0.02), 0 20px 25px -5px rgba(0, 0, 0, 0.03);\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--bg-base);\n    color: var(--text-main);\n    font-family: 'Manrope', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n  \n  .floating-card {\n    background: var(--card-bg);\n    border: 1px solid var(--ghost-border);\n    border-radius: 24px;\n    box-shadow: var(--shadow-floating);\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n  \n  .floating-card:hover {\n    transform: translateY(-8px);\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, var(--text-main) 20%, var(--purple) 60%, var(--orange) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .blurred-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: -1;\n    opacity: 0.15;\n  }\n\n  .debossed-text {\n    color: transparent;\n    background-color: rgba(0, 0, 0, 0.03);\n    -webkit-background-clip: text;\n    text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.8), -1px -1px 2px rgba(0, 0, 0, 0.05);\n  }\n\n  @keyframes slowFloat {\n    0%, 100% { transform: translate(0, 0); }\n    50% { transform: translate(-30px, 40px); }\n  }\n\n  .scrollbar-none::-webkit-scrollbar { display: none; }\n  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div class=\"blurred-orb w-[800px] h-[800px] bg-[#8B5CF6] top-[-300px] left-[-200px] animate-[slowFloat_18s_infinite]\" data-kid=\"2\"></div>\n  <div class=\"blurred-orb w-[700px] h-[700px] bg-[#FB923C] bottom-[-200px] right-[-200px] animate-[slowFloat_25s_infinite_reverse]\" data-kid=\"3\"></div>\n\n  \n  <nav class=\"fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-12 py-6 backdrop-blur-lg bg-white/40 border-b border-black/[0.03]\" data-kid=\"4\">\n    <div class=\"flex items-center gap-3\" data-kid=\"5\">\n      <img src=\"/api/local/images/assets/images/logo.png\" alt=\"Brocus Logo\" class=\"h-10 w-auto\" data-kid=\"6\">\n      <span class=\"font-heading text-xl font-bold tracking-tight text-[#111827]\" data-kid=\"7\">BROCUS</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-10 text-sm font-semibold text-gray-600\" data-kid=\"8\">\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"9\">Solutions</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"10\">Services</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"11\">Impact</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"12\">About</a>\n    </div>\n    <button class=\"px-7 py-3 bg-black text-white text-sm font-bold rounded-full hover:bg-gray-800 transition-all active:scale-95 shadow-lg shadow-black/10\" data-kid=\"13\">\n      Start Project\n    </button>\n  </nav>\n\n  \n  <section class=\"relative h-screen flex flex-col items-center justify-center text-center px-6 overflow-hidden\" data-kid=\"14\">\n    \n    <video src=\"https://videos.pexels.com/video-files/6866291/6866291-hd_1980_1080_25fps.mp4\" poster=\"https://images.pexels.com/videos/6866291/blurred-blurred-light-bright-light-christmas-lights-6866291.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover opacity-10 mix-blend-multiply pointer-events-none\" data-kid=\"15\"></video>\n\n    <div class=\"relative z-10 max-w-5xl\" data-kid=\"16\">\n      <div class=\"inline-flex items-center px-4 py-1.5 rounded-full bg-black/5 border border-black/5 text-[10px] font-bold tracking-[0.2em] text-gray-500 mb-8 uppercase\" data-kid=\"17\">\n        Supercharging Enterprise IT\n      </div>\n      <h1 class=\"font-heading text-7xl md:text-[10rem] font-bold leading-[0.85] tracking-tighter gradient-text mb-10\" data-kid=\"18\">\n        The Future <br data-kid=\"19\"> of Tech is Soft\n      </h1>\n      <p class=\"text-xl md:text-2xl text-gray-500 max-w-2xl mx-auto leading-relaxed mb-14 font-medium\" data-kid=\"20\">\n        We craft high-performance software and secure cloud architectures with a focus on modern minimalism.\n      </p>\n      \n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\" data-kid=\"21\">\n        <div class=\"relative w-full max-w-lg group\" data-kid=\"22\">\n          <input type=\"email\" placeholder=\"Enter your business email\" class=\"w-full px-10 py-5 bg-white border border-black/5 rounded-full focus:outline-hidden focus:ring-4 focus:ring-[#8B5CF6]/10 transition-all shadow-xl shadow-black/[0.02]\" data-kid=\"23\">\n          <button class=\"absolute right-2 top-2 bottom-2 px-8 bg-black text-white text-sm font-bold rounded-full hover:bg-[#8B5CF6] transition-all\" data-kid=\"24\">\n            Connect\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 max-w-7xl mx-auto\" data-kid=\"25\">\n    <div class=\"mb-20 text-center\" data-kid=\"26\">\n      <h2 class=\"font-heading text-5xl font-bold mb-6 tracking-tight\" data-kid=\"27\">Precision Engineered Solutions</h2>\n      <p class=\"text-gray-400 font-medium\" data-kid=\"28\">From discovery to deployment, we build what matters.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[350px]\" data-kid=\"29\">\n      \n      <div class=\"md:col-span-2 md:row-span-2 floating-card p-12 flex flex-col justify-between group relative overflow-hidden bg-white\" data-kid=\"30\">\n        <div class=\"relative z-10\" data-kid=\"31\">\n          <div class=\"w-16 h-16 rounded-2xl bg-[#8B5CF6]/5 flex items-center justify-center mb-8 border border-[#8B5CF6]/10\" data-kid=\"32\">\n            <i class=\"ti ti-cloud-bolt text-3xl text-[#8B5CF6]\" data-kid=\"33\"></i>\n          </div>\n          <h3 class=\"font-heading text-4xl font-bold mb-6 tracking-tight\" data-kid=\"34\">Cloud Migration & Scaling</h3>\n          <p class=\"text-gray-500 text-xl max-w-md leading-relaxed\" data-kid=\"35\">\n            Zero-downtime infrastructure shifts that grow with your user base. Automated scaling for global resilience.\n          </p>\n        </div>\n        \n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/waves.svg\" class=\"absolute bottom-[-100px] right-[-100px] w-[500px] h-[500px] opacity-[0.03] pointer-events-none group-hover:scale-110 transition-transform duration-1000\" style=\"color: #8B5CF6;\" data-kid=\"36\">\n             \n        <div class=\"relative z-10 flex items-center gap-4 text-xs font-bold text-[#8B5CF6] mt-8 cursor-pointer tracking-widest uppercase\" data-kid=\"37\">\n          EXPLORE ARCHITECTURE <i class=\"ti ti-arrow-right\" data-kid=\"38\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"floating-card p-10 flex flex-col justify-between group bg-white\" data-kid=\"39\">\n        <div data-kid=\"40\">\n          <div class=\"w-12 h-12 rounded-xl bg-[#FB923C]/5 flex items-center justify-center mb-8 border border-[#FB923C]/10\" data-kid=\"41\">\n            <i class=\"ti ti-shield-check text-2xl text-[#FB923C]\" data-kid=\"42\"></i>\n          </div>\n          <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"43\">Zero-Trust Security</h3>\n          <p class=\"text-gray-400 text-sm leading-relaxed\" data-kid=\"44\">Enterprise-grade protection for every endpoint and connection.</p>\n        </div>\n        <div class=\"text-[10px] font-bold text-black/10 tracking-[0.3em] mt-4 uppercase\" data-kid=\"45\">ACTIVE PROTECTION</div>\n      </div>\n\n      \n      <div class=\"floating-card p-10 flex flex-col justify-between group bg-white\" data-kid=\"46\">\n        <div data-kid=\"47\">\n          <div class=\"w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center mb-8 border border-black/5\" data-kid=\"48\">\n            <i class=\"ti ti-code text-2xl text-gray-400\" data-kid=\"49\"></i>\n          </div>\n          <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"50\">Custom Software</h3>\n          <p class=\"text-gray-400 text-sm leading-relaxed\" data-kid=\"51\">Bespoke digital tools tailored specifically for your workflow.</p>\n        </div>\n        <div class=\"text-[10px] font-bold text-black/10 tracking-[0.3em] mt-4 uppercase\" data-kid=\"52\">INITIALIZE REPO</div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-48 overflow-hidden\" data-kid=\"53\">\n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"54\">\n      <span class=\"font-heading text-[30vw] font-black leading-none select-none debossed-text\" data-kid=\"55\">99.9%</span>\n    </div>\n    \n    <div class=\"max-w-7xl mx-auto px-12 relative z-10\" data-kid=\"56\">\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-16 text-center\" data-kid=\"57\">\n        <div data-kid=\"58\">\n          <div class=\"font-heading text-6xl font-bold mb-4 tracking-tighter\" data-kid=\"59\">99.9%</div>\n          <div class=\"text-[10px] text-gray-400 font-bold uppercase tracking-[0.3em]\" data-kid=\"60\">Platform Uptime</div>\n        </div>\n        <div data-kid=\"61\">\n          <div class=\"font-heading text-6xl font-bold mb-4 tracking-tighter\" data-kid=\"62\">2.4PB</div>\n          <div class=\"text-[10px] text-gray-400 font-bold uppercase tracking-[0.3em]\" data-kid=\"63\">Data Managed</div>\n        </div>\n        <div data-kid=\"64\">\n          <div class=\"font-heading text-6xl font-bold mb-4 tracking-tighter\" data-kid=\"65\">0</div>\n          <div class=\"text-[10px] text-gray-400 font-bold uppercase tracking-[0.3em]\" data-kid=\"66\">Security Breaches</div>\n        </div>\n        <div data-kid=\"67\">\n          <div class=\"font-heading text-6xl font-bold mb-4 tracking-tighter\" data-kid=\"68\">500+</div>\n          <div class=\"text-[10px] text-gray-400 font-bold uppercase tracking-[0.3em]\" data-kid=\"69\">Happy Partners</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 overflow-hidden bg-white/30 backdrop-blur-sm border-y border-black/[0.02]\" data-kid=\"70\">\n    <div class=\"max-w-7xl mx-auto mb-20 flex items-end justify-between\" data-kid=\"71\">\n      <div data-kid=\"72\">\n        <h2 class=\"font-heading text-5xl font-bold mb-4 tracking-tight\" data-kid=\"73\">Trusted by Giants</h2>\n        <p class=\"text-gray-400 font-medium\" data-kid=\"74\">Don't just take our word for it.</p>\n      </div>\n    </div>\n\n    <div class=\"flex gap-10 overflow-x-auto pb-12 scrollbar-none snap-x\" data-kid=\"75\">\n      \n      <div class=\"floating-card p-12 min-w-[500px] relative group snap-center bg-white\" data-kid=\"76\">\n        <i class=\"ti ti-quote text-7xl text-black/[0.02] absolute top-6 right-8 group-hover:text-[#8B5CF6]/5 transition-colors\" data-kid=\"77\"></i>\n        <p class=\"text-xl text-gray-600 leading-relaxed mb-12 italic font-medium\" data-kid=\"78\">\n          \"Brocus transformed our legacy infrastructure into a cloud-native powerhouse in under 3 months. Their attention to security is unmatched.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"79\">\n          <img src=\"https://i.pravatar.cc/100?u=sarah\" class=\"w-14 h-14 rounded-full border-2 border-white shadow-md grayscale group-hover:grayscale-0 transition-all duration-500\" data-kid=\"80\">\n          <div data-kid=\"81\">\n            <div class=\"font-bold text-lg text-black\" data-kid=\"82\">Sarah Chen</div>\n            <div class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"83\">CTO, Vertex Scale</div>\n          </div>\n        </div>\n      </div>\n      \n      \n      <div class=\"floating-card p-12 min-w-[500px] relative group snap-center bg-white\" data-kid=\"84\">\n        <i class=\"ti ti-quote text-7xl text-black/[0.02] absolute top-6 right-8 group-hover:text-[#FB923C]/5 transition-colors\" data-kid=\"85\"></i>\n        <p class=\"text-xl text-gray-600 leading-relaxed mb-12 italic font-medium\" data-kid=\"86\">\n          \"The most professional development partner we've worked with. The ethereal design isn't just for show—the UX is flawless.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"87\">\n          <img src=\"https://i.pravatar.cc/100?u=james\" class=\"w-14 h-14 rounded-full border-2 border-white shadow-md grayscale group-hover:grayscale-0 transition-all duration-500\" data-kid=\"88\">\n          <div data-kid=\"89\">\n            <div class=\"font-bold text-lg text-black\" data-kid=\"90\">James Wilson</div>\n            <div class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"91\">Product Lead, NexaCorp</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"floating-card p-12 min-w-[500px] relative group snap-center bg-white\" data-kid=\"92\">\n        <i class=\"ti ti-quote text-7xl text-black/[0.02] absolute top-6 right-8 group-hover:text-blue-500/5 transition-colors\" data-kid=\"93\"></i>\n        <p class=\"text-xl text-gray-600 leading-relaxed mb-12 italic font-medium\" data-kid=\"94\">\n          \"Zero breaches in 2 years of operation. Brocus isn't just an IT vendor; they are our primary security buffer.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"95\">\n          <img src=\"https://i.pravatar.cc/100?u=nina\" class=\"w-14 h-14 rounded-full border-2 border-white shadow-md grayscale group-hover:grayscale-0 transition-all duration-500\" data-kid=\"96\">\n          <div data-kid=\"97\">\n            <div class=\"font-bold text-lg text-black\" data-kid=\"98\">Nina Rodriguez</div>\n            <div class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"99\">Founder, SecureNode</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"pt-40 pb-20 px-12 bg-white border-t border-black/[0.03]\" data-kid=\"100\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-20\" data-kid=\"101\">\n      <div class=\"md:col-span-2\" data-kid=\"102\">\n        <div class=\"flex items-center gap-3 mb-8\" data-kid=\"103\">\n          <img src=\"/api/local/images/assets/images/logo.png\" alt=\"Brocus Logo\" class=\"h-10 w-auto\" data-kid=\"104\">\n          <span class=\"font-heading text-2xl font-bold tracking-tighter\" data-kid=\"105\">BROCUS</span>\n        </div>\n        <p class=\"text-gray-400 max-w-sm mb-12 text-lg leading-relaxed\" data-kid=\"106\">\n          Enterprise IT solutions for a digital-first world. Building the infrastructure of tomorrow, today.\n        </p>\n        <div class=\"flex gap-8 text-2xl text-gray-300\" data-kid=\"107\">\n          <i class=\"ti ti-brand-x hover:text-black transition-colors cursor-pointer\" data-kid=\"108\"></i>\n          <i class=\"ti ti-brand-linkedin hover:text-black transition-colors cursor-pointer\" data-kid=\"109\"></i>\n          <i class=\"ti ti-brand-github hover:text-black transition-colors cursor-pointer\" data-kid=\"110\"></i>\n        </div>\n      </div>\n      \n      <div data-kid=\"111\">\n        <h4 class=\"font-heading font-bold mb-8 text-black tracking-tight\" data-kid=\"112\">Solutions</h4>\n        <ul class=\"space-y-5 text-sm font-semibold text-gray-400\" data-kid=\"113\">\n          <li data-kid=\"114\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"115\">Cloud Architecture</a></li>\n          <li data-kid=\"116\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"117\">Cybersecurity</a></li>\n          <li data-kid=\"118\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"119\">Product Dev</a></li>\n          <li data-kid=\"120\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"121\">Consultancy</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"122\">\n        <h4 class=\"font-heading font-bold mb-8 text-black tracking-tight\" data-kid=\"123\">Company</h4>\n        <ul class=\"space-y-5 text-sm font-semibold text-gray-400\" data-kid=\"124\">\n          <li data-kid=\"125\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"126\">Our Story</a></li>\n          <li data-kid=\"127\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"128\">Contact</a></li>\n          <li data-kid=\"129\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"130\">Privacy Policy</a></li>\n          <li data-kid=\"131\"><a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"132\">Terms</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-32 pt-10 border-t border-black/[0.03] flex justify-between items-center text-[10px] font-bold text-gray-300 tracking-[0.2em] uppercase\" data-kid=\"133\">\n      <div data-kid=\"134\">&copy; 2024 Brocus IT Solutions</div>\n      <div class=\"flex gap-10\" data-kid=\"135\">\n        <a href=\"#\" class=\"hover:text-black\" data-kid=\"136\">Twitter</a>\n        <a href=\"#\" class=\"hover:text-black\" data-kid=\"137\">LinkedIn</a>\n        <a href=\"#\" class=\"hover:text-black\" data-kid=\"138\">Dribbble</a>\n      </div>\n    </div>\n  </footer>\n</div>",
