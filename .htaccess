Options -Indexes

# ── Charset / MIME ──────────────────────────────────
AddDefaultCharset UTF-8

# ── Security headers ────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Uncomment on HTTPS production:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Compression ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# ── Browser caching ─────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType text/html              "access plus 0 seconds"
    ExpiresByType application/json       "access plus 0 seconds"
</IfModule>

# ── Protect sensitive directories (NOT handlers — forms POST there) ──
<FilesMatch "^(config|includes)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Hide PHP version
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# ── Clean URLs (remove .php extension) ──────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Stop mod_dir from adding trailing slashes (fixes directory/file name collision)
    DirectorySlash Off

    # 1) Force HTTPS (uncomment on production)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2) Redirect /index.php to subfolder root
    RewriteCond %{THE_REQUEST} \s/brocusitsolutionsusa/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ /brocusitsolutionsusa/ [R=301,L]

    # 3) Redirect any .php URL to the clean version (301 permanent)
    #    EXCEPT handler files — POST requests must not be redirected
    RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/handlers/ [NC]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L]

    # 4) Redirect any other .php URL to its clean version
    RewriteCond %{THE_REQUEST} \s/brocusitsolutionsusa/([^.]+)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ /brocusitsolutionsusa/$1 [R=301,L]

    # 5) Handle directory collision: /home-security or /home-security/ → home-security.php
    RewriteRule ^home-security/?$ home-security.php [L]

    # 6) Internally rewrite clean URLs to .php files
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]

</IfModule>
